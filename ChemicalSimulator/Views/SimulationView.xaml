<UserControl x:Class="ChemicalSimulator.Views.SimulationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:ChemicalSimulator.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header com Status -->
        <materialDesign:ColorZone Grid.Row="0" 
                                  Mode="PrimaryMid" 
                                  Padding="24,16"
                                  materialDesign:ElevationAssist.Elevation="Dp4">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="FlaskOutline" 
                                            Width="32" 
                                            Height="32"
                                            VerticalAlignment="Center"
                                            Margin="0,0,16,0"/>
                    <StackPanel>
                        <TextBlock Text="Simulação de Reações Químicas" 
                                  Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                                  Foreground="White"/>
                        <TextBlock Text="{Binding StatusMessage}" 
                                  FontSize="12"
                                  Foreground="White"
                                  Opacity="0.8"
                                  Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Botões de Controle -->
                <StackPanel Orientation="Horizontal" 
                           HorizontalAlignment="Right">
                    <Button Style="{StaticResource MaterialDesignRaisedLightButton}"
                           Margin="8,0"
                           Padding="24,8"
                           Command="{Binding StartSimulationCommand}"
                           IsEnabled="{Binding IsSimulating, Converter={StaticResource InverseBooleanConverter}}">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Play" 
                                                        Margin="0,0,8,0"
                                                        VerticalAlignment="Center"/>
                                <TextBlock Text="INICIAR"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>

                    <Button Style="{StaticResource MaterialDesignOutlinedLightButton}"
                           Margin="8,0"
                           Command="{Binding StopSimulationCommand}"
                           Visibility="{Binding IsSimulating, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Stop" 
                                                        Margin="0,0,8,0"/>
                                <TextBlock Text="PARAR"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </StackPanel>
            </Grid>
        </materialDesign:ColorZone>

        <!-- Conteúdo Principal -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- Painel Esquerdo - Reagentes e Condições -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Reagentes -->
                <materialDesign:Card Grid.Row="0" 
                                    Margin="8"
                                    Padding="0"
                                    materialDesign:ElevationAssist.Elevation="Dp2">
                    <StackPanel>
                        <Border Background="{DynamicResource PrimaryHueMidBrush}" 
                               Padding="16">
                            <TextBlock Text="Reagentes" 
                                      Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                      Foreground="White"/>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                     MaxHeight="300">
                            <ItemsControl ItemsSource="{Binding Reactants}" 
                                         Margin="16">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <materialDesign:Card Margin="0,8" 
                                                            Padding="12">
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" 
                                                              FontWeight="SemiBold"
                                                              FontSize="14"/>
                                                    <TextBlock Text="{Binding Formula}" 
                                                              Foreground="Gray"
                                                              FontSize="16"
                                                              Margin="0,4"/>
                                                    <TextBlock FontSize="11" 
                                                              Foreground="Gray">
                                                        <Run Text="M = "/>
                                                        <Run Text="{Binding MolarMass, StringFormat={}{0:F2}}"/>
                                                        <Run Text=" g/mol"/>
                                                    </TextBlock>
                                                </StackPanel>

                                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                                       VerticalAlignment="Top"
                                                       HorizontalAlignment="Right"
                                                       Command="{Binding DataContext.RemoveReactantCommand, 
                                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}">
                                                    <materialDesign:PackIcon Kind="Close"/>
                                                </Button>
                                            </Grid>
                                        </materialDesign:Card>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Button Content="+ ADICIONAR REAGENTE"
                               Style="{StaticResource MaterialDesignOutlinedButton}"
                               Margin="16"
                               HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Condições da Reação -->
                <materialDesign:Card Grid.Row="1" 
                                    Margin="8"
                                    Padding="0"
                                    materialDesign:ElevationAssist.Elevation="Dp2">
                    <StackPanel>
                        <Border Background="{DynamicResource SecondaryHueMidBrush}" 
                               Padding="16">
                            <TextBlock Text="Condições" 
                                      Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                      Foreground="White"/>
                        </Border>

                        <StackPanel Margin="16">
                            <!-- Temperatura -->
                            <StackPanel Margin="0,12,0,0">
                                <Grid>
                                    <TextBlock Text="Temperatura" 
                                              FontWeight="SemiBold"/>
                                    <TextBlock HorizontalAlignment="Right">
                                        <Run Text="{Binding Conditions.Temperature, StringFormat={}{0:F1}}"/>
                                        <Run Text="K"/>
                                        <Run Text="("/><Run Text="{Binding Conditions.Temperature, Converter={StaticResource KelvinToCelsiusConverter}}"/><Run Text=")"/>
                                    </TextBlock>
                                </Grid>
                                <Slider Minimum="200" 
                                       Maximum="500" 
                                       Value="{Binding Conditions.Temperature}"
                                       TickFrequency="50"
                                       IsSnapToTickEnabled="True"
                                       Margin="0,8"
                                       Style="{StaticResource MaterialDesignDiscreteSlider}"/>
                            </StackPanel>

                            <!-- Pressão -->
                            <StackPanel Margin="0,12,0,0">
                                <Grid>
                                    <TextBlock Text="Pressão" 
                                              FontWeight="SemiBold"/>
                                    <TextBlock HorizontalAlignment="Right">
                                        <Run Text="{Binding Conditions.Pressure, StringFormat={}{0:F1}}"/>
                                        <Run Text="kPa"/>
                                    </TextBlock>
                                </Grid>
                                <Slider Minimum="50" 
                                       Maximum="200" 
                                       Value="{Binding Conditions.Pressure}"
                                       TickFrequency="25"
                                       IsSnapToTickEnabled="True"
                                       Margin="0,8"
                                       Style="{StaticResource MaterialDesignDiscreteSlider}"/>
                            </StackPanel>

                            <!-- pH -->
                            <StackPanel Margin="0,12,0,0">
                                <Grid>
                                    <TextBlock Text="pH" 
                                              FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Conditions.pH, StringFormat={}{0:F1}}" 
                                              HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider Minimum="0" 
                                       Maximum="14" 
                                       Value="{Binding Conditions.pH}"
                                       TickFrequency="1"
                                       IsSnapToTickEnabled="True"
                                       Margin="0,8"
                                       Style="{StaticResource MaterialDesignDiscreteSlider}"/>
                            </StackPanel>

                            <!-- Solvente -->
                            <ComboBox materialDesign:HintAssist.Hint="Solvente"
                                     Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                     Margin="0,16,0,0"
                                     SelectedItem="{Binding Conditions.Solvent}">
                                <ComboBoxItem Content="Nenhum"/>
                                <ComboBoxItem Content="Água" IsSelected="True"/>
                                <ComboBoxItem Content="Etanol"/>
                                <ComboBoxItem Content="Acetona"/>
                                <ComboBoxItem Content="Hexano"/>
                                <ComboBoxItem Content="DMSO"/>
                            </ComboBox>

                            <!-- Catalisador -->
                            <ComboBox materialDesign:HintAssist.Hint="Catalisador"
                                     Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                     Margin="0,16,0,0"
                                     SelectedItem="{Binding Conditions.Catalyst}">
                                <ComboBoxItem Content="Nenhum" IsSelected="True"/>
                                <ComboBoxItem Content="Pt (Platina)"/>
                                <ComboBoxItem Content="Pd (Paládio)"/>
                                <ComboBoxItem Content="H₂SO₄"/>
                                <ComboBoxItem Content="NaOH"/>
                                <ComboBoxItem Content="Enzima"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>

            <!-- Área Central - Visualização da Reação -->
            <materialDesign:Card Grid.Column="1" 
                                Margin="8"
                                materialDesign:ElevationAssist.Elevation="Dp4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Visualizador 3D da Reação -->
                    <Border Grid.Row="0" Background="#F5F5F5">
                        <Grid>
                            <!-- Antes da Simulação -->
                            <StackPanel VerticalAlignment="Center" 
                                       HorizontalAlignment="Center"
                                       Visibility="{Binding HasReaction, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                <materialDesign:PackIcon Kind="Flask" 
                                                        Width="120" 
                                                        Height="120"
                                                        Foreground="#CCCCCC"
                                                        HorizontalAlignment="Center"/>
                                <TextBlock Text="Configure os reagentes e clique em INICIAR SIMULAÇÃO" 
                                          FontSize="16"
                                          Foreground="#999"
                                          HorizontalAlignment="Center"
                                          Margin="0,24,0,0"
                                          TextAlignment="Center"
                                          MaxWidth="300"
                                          TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Durante/Após Simulação -->
                            <controls:MoleculeViewer3D x:Name="ReactionViewer"
                                                       Visibility="{Binding HasReaction, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>
                    </Border>

                    <!-- Barra de Progresso -->
                    <ProgressBar Grid.Row="1" 
                                Height="8"
                                Value="{Binding SimulationProgress}"
                                Maximum="100"
                                Visibility="{Binding IsSimulating, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>
            </materialDesign:Card>

            <!-- Painel Direito - Produtos e Resultados -->
            <materialDesign:Card Grid.Column="2" 
                                Margin="8"
                                Padding="0"
                                materialDesign:ElevationAssist.Elevation="Dp2">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="{DynamicResource PrimaryHueMidBrush}" 
                               Padding="16">
                            <TextBlock Text="Resultados" 
                                      Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                      Foreground="White"/>
                        </Border>

                        <!-- Produtos -->
                        <StackPanel Margin="16" 
                                   Visibility="{Binding HasReaction, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Produtos" 
                                      Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                      Margin="0,0,0,8"/>

                            <ItemsControl ItemsSource="{Binding Products}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <materialDesign:Card Margin="0,8" 
                                                            Padding="12"
                                                            Background="{DynamicResource MaterialDesignChipBackground}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" 
                                                          FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Formula}" 
                                                          FontSize="18"
                                                          Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                          Margin="0,4"/>
                                            </StackPanel>
                                        </materialDesign:Card>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Separator Margin="16,8" 
                                  Visibility="{Binding HasReaction, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <!-- Termodinâmica -->
                        <StackPanel Margin="16" 
                                   Visibility="{Binding HasReaction, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Termodinâmica" 
                                      Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                      Margin="0,0,0,8"/>

                            <!-- ΔH -->
                            <materialDesign:Card Padding="16" 
                                                Margin="0,8">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="ΔH (Entalpia)" 
                                                  FontSize="12"
                                                  Foreground="Gray"/>
                                        <StackPanel Orientation="Horizontal" 
                                                   Margin="0,4">
                                            <TextBlock Text="{Binding CurrentReaction.EnthalpyChange, StringFormat={}{0:F2}}" 
                                                      FontSize="24"
                                                      FontWeight="Bold"/>
                                            <TextBlock Text=" kJ/mol" 
                                                      FontSize="14"
                                                      VerticalAlignment="Bottom"
                                                      Margin="4,0,0,4"/>
                                        </StackPanel>
                                        <Border Background="{Binding CurrentReaction.IsExothermic, Converter={StaticResource BooleanToColorConverter}}"
                                               CornerRadius="4"
                                               Padding="8,4"
                                               HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding CurrentReaction.IsExothermic, Converter={StaticResource ExothermicLabelConverter}}" 
                                                      Foreground="White"
                                                      FontSize="11"
                                                      FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>

                                    <materialDesign:PackIcon Kind="{Binding CurrentReaction.IsExothermic, Converter={StaticResource ExothermicIconConverter}}" 
                                                            Width="48" 
                                                            Height="48"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Opacity="0.2"/>
                                </Grid>
                            </materialDesign:Card>

                            <!-- ΔG -->
                            <materialDesign:Card Padding="16" 
                                                Margin="0,8">
                                <StackPanel>
                                    <TextBlock Text="ΔG (Energia Livre de Gibbs)" 
                                              FontSize="12"
                                              Foreground="Gray"/>
                                    <StackPanel Orientation="Horizontal" 
                                               Margin="0,4">
                                        <TextBlock Text="{Binding CurrentReaction.GibbsFreeEnergy, StringFormat={}{0:F2}}" 
                                                  FontSize="24"
                                                  FontWeight="Bold"/>
                                        <TextBlock Text=" kJ/mol" 
                                                  FontSize="14"
                                                  VerticalAlignment="Bottom"
                                                  Margin="4,0,0,4"/>
                                    </StackPanel>
                                    <Border Background="{Binding CurrentReaction.IsSpontaneous, Converter={StaticResource BooleanToColorConverter}}"
                                           CornerRadius="4"
                                           Padding="8,4"
                                           HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding CurrentReaction.IsSpontaneous, Converter={StaticResource SpontaneousLabelConverter}}" 
                                                  Foreground="White"
                                                  FontSize="11"
                                                  FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                            </materialDesign:Card>

                            <!-- Energia de Ativação -->
                            <materialDesign:Card Padding="16" 
                                                Margin="0,8"
                                                Background="{DynamicResource MaterialDesignChipBackground}">
                                <StackPanel>
                                    <TextBlock Text="Energia de Ativação" 
                                              FontSize="12"
                                              Foreground="Gray"/>
                                    <StackPanel Orientation="Horizontal" 
                                               Margin="0,4">
                                        <TextBlock Text="{Binding CurrentReaction.ActivationEnergy, StringFormat={}{0:F2}}" 
                                                  FontSize="20"
                                                  FontWeight="Bold"/>
                                        <TextBlock Text=" kJ/mol" 
                                                  FontSize="12"
                                                  VerticalAlignment="Bottom"
                                                  Margin="4,0,0,3"/>
                                    </StackPanel>
                                </StackPanel>
                            </materialDesign:Card>
                        </StackPanel>

                        <Separator Margin="16,8" 
                                  Visibility="{Binding HasReaction, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <!-- Cinética -->
                        <StackPanel Margin="16" 
                                   Visibility="{Binding HasReaction, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Cinética" 
                                      Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                      Margin="0,0,0,8"/>

                            <materialDesign:Card Padding="12" 
                                                Margin="0,4"
                                                Background="{DynamicResource MaterialDesignChipBackground}">
                                <Grid>
                                    <TextBlock Text="Constante de Velocidade" 
                                              FontSize="11"
                                              Foreground="Gray"/>
                                    <TextBlock Text="{Binding CurrentReaction.RateConstant, StringFormat={}{0:E2} s⁻¹}" 
                                              FontWeight="SemiBold"
                                              HorizontalAlignment="Right"/>
                                </Grid>
                            </materialDesign:Card>

                            <materialDesign:Card Padding="12" 
                                                Margin="0,4"
                                                Background="{DynamicResource MaterialDesignChipBackground}">
                                <Grid>
                                    <TextBlock Text="Ordem da Reação" 
                                              FontSize="11"
                                              Foreground="Gray"/>
                                    <TextBlock Text="{Binding CurrentReaction.ReactionOrder}" 
                                              FontWeight="SemiBold"
                                              HorizontalAlignment="Right"/>
                                </Grid>
                            </materialDesign:Card>
                        </StackPanel>

                        <!-- Botão Analisar -->
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                               Margin="16"
                               HorizontalAlignment="Stretch"
                               Command="{Binding AnalyzeReactionCommand}"
                               Visibility="{Binding HasReaction, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ChartLine" 
                                                            Margin="0,0,8,0"/>
                                    <TextBlock Text="VER ANÁLISE"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </materialDesign:Card>
        </Grid>

        <!-- Rodapé com Ações -->
        <Border Grid.Row="2" 
               Background="{DynamicResource MaterialDesignPaper}"
               BorderBrush="{DynamicResource MaterialDesignDivider}"
               BorderThickness="0,1,0,0"
               Padding="24,12">
            <Grid>
                <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                       Command="{Binding ResetSimulationCommand}">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" 
                                                    Margin="0,0,8,0"/>
                            <TextBlock Text="RESETAR"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>