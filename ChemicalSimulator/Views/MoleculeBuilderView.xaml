<UserControl x:Class="ChemicalSimulator.Views.MoleculeBuilderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helix="http://helix-toolkit.org/wpf"
             xmlns:converters="clr-namespace:ChemicalSimulator.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1600"
             Background="{DynamicResource MaterialDesign.Brush.Background}">

    <UserControl.Resources>
        <converters:ElementCategoryToColorConverter x:Key="ElementCategoryToColorConverter"/>
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="350"/>
        </Grid.ColumnDefinitions>

        <!-- Painel Esquerdo: Seleção de Elementos -->
        <materialDesign:Card Grid.Column="0" Margin="0,0,8,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Cabeçalho -->
                <Border Grid.Row="0" Background="{DynamicResource MaterialDesign.Brush.Primary}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="🧪 Elementos Químicos" FontSize="18" FontWeight="Bold" 
                                 Foreground="White"/>
                        <TextBlock Text="Selecione para adicionar" FontSize="12" Foreground="White" Opacity="0.9"/>
                    </StackPanel>
                </Border>

                <!-- Busca -->
                <TextBox Grid.Row="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        materialDesign:HintAssist.Hint="Buscar elemento..."
                        materialDesign:TextFieldAssist.HasClearButton="True"
                        materialDesign:TextFieldAssist.PrefixText="🔍"
                        Margin="16,16,16,8"/>

                <!-- Lista de Elementos -->
                <ListBox Grid.Row="2" ItemsSource="{Binding FilteredElements}"
                        SelectedItem="{Binding SelectedElement}"
                        Margin="8">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8" CornerRadius="4" Margin="4">
                                <Border.Background>
                                    <SolidColorBrush Color="{Binding Category, Converter={StaticResource ElementCategoryToColorConverter}}" 
                                                   Opacity="0.3"/>
                                </Border.Background>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="{DynamicResource MaterialDesign.Brush.Primary}"
                                          CornerRadius="25" Width="40" Height="40">
                                        <TextBlock Text="{Binding Symbol}" FontSize="16" FontWeight="Bold"
                                                 Foreground="White" HorizontalAlignment="Center" 
                                                 VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="14"/>
                                        <TextBlock FontSize="11" Opacity="0.7">
                                            <Run Text="Z="/>
                                            <Run Text="{Binding AtomicNumber}"/>
                                            <Run Text=" | "/>
                                            <Run Text="{Binding AtomicMass, StringFormat=F2}"/>
                                            <Run Text=" u"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Templates Rápidos -->
                <StackPanel Grid.Row="3" Margin="16,8,16,16">
                    <TextBlock Text="⚡ Templates Rápidos" FontWeight="Medium" Margin="0,0,0,8"/>
                    <WrapPanel>
                        <Button Content="H₂O" Command="{Binding LoadTemplateCommand}" 
                               CommandParameter="water" Style="{StaticResource MaterialDesignOutlinedButton}"
                               Margin="4"/>
                        <Button Content="CH₄" Command="{Binding LoadTemplateCommand}" 
                               CommandParameter="methane" Style="{StaticResource MaterialDesignOutlinedButton}"
                               Margin="4"/>
                        <Button Content="CO₂" Command="{Binding LoadTemplateCommand}" 
                               CommandParameter="co2" Style="{StaticResource MaterialDesignOutlinedButton}"
                               Margin="4"/>
                        <Button Content="NH₃" Command="{Binding LoadTemplateCommand}" 
                               CommandParameter="ammonia" Style="{StaticResource MaterialDesignOutlinedButton}"
                               Margin="4"/>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <!-- Painel Central: Visualização 3D -->
        <materialDesign:Card Grid.Column="1" Margin="4,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Cabeçalho -->
                <Border Grid.Row="0" Background="{DynamicResource MaterialDesign.Brush.Primary}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="🔬 Visualização 3D da Molécula" FontSize="18" FontWeight="Bold" 
                                 Foreground="White"/>
                        <TextBlock Text="{Binding MoleculeName}" FontSize="14" Foreground="White" Opacity="0.9"/>
                    </StackPanel>
                </Border>

                <!-- Viewport 3D -->
                <Grid Grid.Row="1" Background="#F5F5F5">
                    <helix:HelixViewport3D x:Name="Viewport3D" 
                                          ShowCoordinateSystem="True"
                                          ShowViewCube="True"
                                          IsInertiaEnabled="True"
                                          ZoomExtentsWhenLoaded="True">
                        
                        <!-- Iluminação -->
                        <helix:DefaultLights/>

                        <!-- Átomos -->
                        <ModelVisual3D x:Name="MoleculeModel">
                            <!-- Átomos serão adicionados dinamicamente no code-behind -->
                        </ModelVisual3D>
                    </helix:HelixViewport3D>

                    <!-- Mensagem quando vazio -->
                    <TextBlock Text="Adicione átomos para começar a construir sua molécula"
                             FontSize="20" FontStyle="Italic" Opacity="0.5"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Visibility="{Binding CurrentAtoms.Count, Converter={StaticResource CountToVisibilityConverter}}"/>
                </Grid>

                <!-- Controles da Visualização -->
                <Border Grid.Row="2" Background="{DynamicResource MaterialDesign.Brush.Card.Background}" Padding="16">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="🔄 Otimizar Geometria" 
                               Command="{Binding OptimizeGeometryCommand}"
                               Style="{StaticResource MaterialDesignRaisedButton}"
                               Margin="0,0,8,0"/>
                        <Button Content="🔍 Zoom Extents" 
                               Click="ZoomExtents_Click"
                               Style="{StaticResource MaterialDesignOutlinedButton}"
                               Margin="0,0,8,0"/>
                        <ToggleButton Content="🌐 Rotação Automática" x:Name="AutoRotateToggle"
                                    Click="AutoRotate_Click"
                                    Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </materialDesign:Card>

        <!-- Painel Direito: Propriedades e Controles -->
        <materialDesign:Card Grid.Column="2" Margin="8,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Informações da Molécula -->
                    <Border Background="{DynamicResource MaterialDesign.Brush.Primary}" Padding="16">
                        <TextBlock Text="📊 Propriedades" FontSize="18" FontWeight="Bold" 
                                 Foreground="White"/>
                    </Border>

                    <StackPanel Margin="16">
                        <TextBox Text="{Binding MoleculeName, UpdateSourceTrigger=PropertyChanged}"
                                materialDesign:HintAssist.Hint="Nome da Molécula"
                                Margin="0,0,0,16"/>

                        <Border Background="{DynamicResource MaterialDesign.Brush.Primary}" 
                              CornerRadius="4" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Fórmula Molecular" FontSize="12" Opacity="0.9" 
                                         Foreground="White"/>
                                <TextBlock Text="{Binding MolecularFormula}" FontSize="20" FontWeight="Bold"
                                         Foreground="White"/>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#4CAF50" CornerRadius="4" Padding="8" Margin="0,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="Massa Molar" FontSize="11" Foreground="White"/>
                                    <TextBlock Text="{Binding MolarMass, StringFormat=F2}" FontSize="16" 
                                             FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="g/mol" FontSize="10" Foreground="White" Opacity="0.9"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="#FF9800" CornerRadius="4" Padding="8" Margin="4,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Carga Total" FontSize="11" Foreground="White"/>
                                    <TextBlock Text="{Binding TotalCharge}" FontSize="16" FontWeight="Bold" 
                                             Foreground="White"/>
                                    <TextBlock Text="e⁻" FontSize="10" Foreground="White" Opacity="0.9"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- Controles de Adição -->
                    <Separator Margin="16,8"/>

                    <StackPanel Margin="16">
                        <TextBlock Text="➕ Adicionar Átomo" FontWeight="Medium" Margin="0,0,0,8"/>
                        <Button Content="Adicionar Átomo Selecionado" 
                               Command="{Binding AddAtomCommand}"
                               Style="{StaticResource MaterialDesignRaisedButton}"
                               Margin="0,0,0,16"/>

                        <TextBlock Text="🔗 Criar Ligação" FontWeight="Medium" Margin="0,8,0,8"/>
                        
                        <TextBlock Text="Átomo 1:" FontSize="12" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding CurrentAtoms}"
                                SelectedItem="{Binding SelectedAtom1}"
                                DisplayMemberPath="Element.Symbol"
                                Margin="0,0,0,8"/>

                        <TextBlock Text="Átomo 2:" FontSize="12" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding CurrentAtoms}"
                                SelectedItem="{Binding SelectedAtom2}"
                                DisplayMemberPath="Element.Symbol"
                                Margin="0,0,0,8"/>

                        <TextBlock Text="Tipo de Ligação:" FontSize="12" Margin="0,0,0,4"/>
                        <ComboBox SelectedValue="{Binding SelectedBondType}" Margin="0,0,0,8">
                            <ComboBoxItem Content="Simples" Tag="Single"/>
                            <ComboBoxItem Content="Dupla" Tag="Double"/>
                            <ComboBoxItem Content="Tripla" Tag="Triple"/>
                            <ComboBoxItem Content="Iônica" Tag="Ionic"/>
                        </ComboBox>

                        <Button Content="Criar Ligação" 
                               Command="{Binding AddBondCommand}"
                               Style="{StaticResource MaterialDesignRaisedButton}"
                               Margin="0,0,0,16"/>
                    </StackPanel>

                    <!-- Lista de Átomos e Ligações -->
                    <Separator Margin="16,8"/>

                    <StackPanel Margin="16">
                        <TextBlock Text="⚛️ Átomos na Molécula" FontWeight="Medium" Margin="0,0,0,8"/>
                        <ListBox ItemsSource="{Binding CurrentAtoms}" MaxHeight="150"
                                Margin="0,0,0,8">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0">
                                            <Run Text="{Binding Element.Symbol}" FontWeight="Bold"/>
                                            <Run Text=" - "/>
                                            <Run Text="{Binding Element.Name}"/>
                                        </TextBlock>
                                        <Button Grid.Column="1" Content="✖" 
                                               Command="{Binding DataContext.RemoveAtomCommand, 
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}"
                                               Style="{StaticResource MaterialDesignFlatButton}"
                                               Foreground="Red" Padding="4"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="🔗 Ligações" FontWeight="Medium" Margin="0,8,0,8"/>
                        <ListBox ItemsSource="{Binding CurrentBonds}" MaxHeight="100">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0">
                                            <Run Text="{Binding Atom1.Element.Symbol}"/>
                                            <Run Text=" ─ "/>
                                            <Run Text="{Binding Atom2.Element.Symbol}"/>
                                            <Run Text=" ("/>
                                            <Run Text="{Binding Type}"/>
                                            <Run Text=")"/>
                                        </TextBlock>
                                        <Button Grid.Column="1" Content="✖" 
                                               Command="{Binding DataContext.RemoveBondCommand, 
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}"
                                               Style="{StaticResource MaterialDesignFlatButton}"
                                               Foreground="Red" Padding="4"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <!-- Ações -->
                    <Separator Margin="16,8"/>

                    <StackPanel Margin="16">
                        <Button Content="💾 Salvar Molécula" 
                               Command="{Binding SaveMoleculeCommand}"
                               Style="{StaticResource MaterialDesignRaisedButton}"
                               Background="#4CAF50"
                               Margin="0,0,0,8"/>
                        
                        <Button Content="🗑️ Limpar Tudo" 
                               Command="{Binding ClearMoleculeCommand}"
                               Style="{StaticResource MaterialDesignOutlinedButton}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </materialDesign:Card>
    </Grid>
</UserControl>
