
<UserControl x:Class="ChemicalSimulator.Views.MoleculeBuilderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:ChemicalSimulator.Controls">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- Painel Esquerdo - Ferramentas de Construção -->
        <materialDesign:Card Grid.Column="0" 
                            Margin="8"
                            Padding="0"
                            materialDesign:ElevationAssist.Elevation="Dp2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Header -->
                    <Border Background="{DynamicResource PrimaryHueMidBrush}" 
                           Padding="16">
                        <StackPanel>
                            <TextBlock Text="Construtor de Moléculas" 
                                      Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                      Foreground="White"/>
                            <TextBlock Text="Monte sua molécula átomo por átomo" 
                                      FontSize="11"
                                      Foreground="White"
                                      Opacity="0.8"/>
                        </StackPanel>
                    </Border>

                    <!-- Tabela Periódica Compacta -->
                    <Expander Header="Elementos Químicos"
                             IsExpanded="True"
                             Margin="8">
                        <controls:PeriodicTableControl Margin="8"/>
                    </Expander>

                    <!-- Ferramentas de Ligação -->
                    <Expander Header="Tipos de Ligação"
                             IsExpanded="True"
                             Margin="8">
                        <StackPanel Margin="16,8">
                            <RadioButton Content="Ligação Simples"
                                       GroupName="BondType"
                                       IsChecked="True"
                                       Margin="0,4"
                                       Command="{Binding SelectBondTypeCommand}"
                                       CommandParameter="Single"/>

                            <RadioButton Content="Ligação Dupla"
                                       GroupName="BondType"
                                       Margin="0,4"
                                       Command="{Binding SelectBondTypeCommand}"
                                       CommandParameter="Double"/>

                            <RadioButton Content="Ligação Tripla"
                                       GroupName="BondType"
                                       Margin="0,4"
                                       Command="{Binding SelectBondTypeCommand}"
                                       CommandParameter="Triple"/>

                            <RadioButton Content="Ligação Iônica"
                                       GroupName="BondType"
                                       Margin="0,4"
                                       Command="{Binding SelectBondTypeCommand}"
                                       CommandParameter="Ionic"/>

                            <Separator Margin="0,12"/>

                            <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                   HorizontalAlignment="Stretch"
                                   Margin="0,8"
                                   Command="{Binding CreateBondCommand}">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="LinkVariant" 
                                                               Margin="0,0,8,0"
                                                               VerticalAlignment="Center"/>
                                        <TextBlock Text="CRIAR LIGAÇÃO"/>
                                    </StackPanel>
                                </Button.Content>
                            </Button>
                        </StackPanel>
                    </Expander>

                    <!-- Ações Rápidas -->
                    <Expander Header="Ações"
                             IsExpanded="True"
                             Margin="8">
                        <StackPanel Margin="16,8">
                            <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                   HorizontalAlignment="Stretch"
                                   Margin="0,4"
                                   Command="{Binding OptimizeGeometryCommand}">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="AutoFix" 
                                                               Margin="0,0,8,0"/>
                                        <TextBlock Text="Otimizar Geometria"/>
                                    </StackPanel>
                                </Button.Content>
                            </Button>

                            <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                   HorizontalAlignment="Stretch"
                                   Margin="0,4"
                                   Command="{Binding ClearMoleculeCommand}">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="DeleteSweep" 
                                                               Margin="0,0,8,0"/>
                                        <TextBlock Text="Limpar Tudo"/>
                                    </StackPanel>
                                </Button.Content>
                            </Button>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </materialDesign:Card>

        <!-- Área Central - Visualização 3D -->
        <Grid Grid.Column="1" Margin="8">
            <materialDesign:Card materialDesign:ElevationAssist.Elevation="Dp4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar Superior -->
                    <Border Grid.Row="0" 
                           Background="{DynamicResource MaterialDesignChipBackground}"
                           Padding="16,8">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Molecule" 
                                                        Width="24" 
                                                        Height="24"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding CurrentMolecule.Name}" 
                                          FontSize="18"
                                          FontWeight="SemiBold"
                                          VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" 
                                       HorizontalAlignment="Right">
                                <Border Background="{DynamicResource PrimaryHueLightBrush}"
                                       CornerRadius="12"
                                       Padding="12,4"
                                       Margin="4">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Atom" 
                                                               Width="16" 
                                                               Height="16"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding AtomCount}" 
                                                  FontWeight="SemiBold"
                                                  VerticalAlignment="Center"/>
                                        <TextBlock Text=" átomos" 
                                                  FontSize="11"
                                                  VerticalAlignment="Center"
                                                  Margin="2,0,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource SecondaryHueLightBrush}"
                                       CornerRadius="12"
                                       Padding="12,4"
                                       Margin="4">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="LinkVariant" 
                                                               Width="16" 
                                                               Height="16"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding BondCount}" 
                                                  FontWeight="SemiBold"
                                                  VerticalAlignment="Center"/>
                                        <TextBlock Text=" ligações" 
                                                  FontSize="11"
                                                  VerticalAlignment="Center"
                                                  Margin="2,0,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Visualizador 3D -->
                    <controls:MoleculeViewer3D Grid.Row="1" 
                                               x:Name="MoleculeViewer"
                                               Margin="0"/>

                    <!-- Barra Inferior de Ações -->
                    <Border Grid.Row="2" 
                           Background="{DynamicResource MaterialDesignPaper}"
                           BorderBrush="{DynamicResource MaterialDesignDivider}"
                           BorderThickness="0,1,0,0"
                           Padding="16">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBox materialDesign:HintAssist.Hint="Nome da molécula"
                                        Text="{Binding MoleculeName, UpdateSourceTrigger=PropertyChanged}"
                                        Width="200"
                                        Margin="0,0,16,0"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                                <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                       Command="{Binding SaveMoleculeCommand}">
                                    <Button.Content>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ContentSave" 
                                                                   Margin="0,0,8,0"/>
                                            <TextBlock Text="SALVAR"/>
                                        </StackPanel>
                                    </Button.Content>
                                </Button>
                            </StackPanel>

                            <TextBlock Text="{Binding CurrentMolecule.Formula}" 
                                      FontSize="20"
                                      FontWeight="Bold"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        </Grid>
                    </Border>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <!-- Painel Direito - Propriedades da Molécula -->
        <materialDesign:Card Grid.Column="2" 
                            Margin="8"
                            Padding="0"
                            materialDesign:ElevationAssist.Elevation="Dp2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Header -->
                    <Border Background="{DynamicResource PrimaryHueMidBrush}" 
                           Padding="16">
                        <TextBlock Text="Propriedades" 
                                  Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                  Foreground="White"/>
                    </Border>

                    <!-- Informações Básicas -->
                    <StackPanel Margin="16">
                        <TextBlock Text="Informações Gerais" 
                                  Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                  Margin="0,0,0,12"/>

                        <materialDesign:Card Padding="12" 
                                            Margin="0,4"
                                            Background="{DynamicResource MaterialDesignChipBackground}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Fórmula Molecular" 
                                          FontSize="12"
                                          Foreground="Gray"/>
                                <TextBlock Grid.Column="1" 
                                          Text="{Binding CurrentMolecule.Formula}" 
                                          FontSize="16"
                                          FontWeight="Bold"
                                          HorizontalAlignment="Right"/>
                            </Grid>
                        </materialDesign:Card>

                        <materialDesign:Card Padding="12" 
                                            Margin="0,4"
                                            Background="{DynamicResource MaterialDesignChipBackground}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Massa Molar" 
                                          FontSize="12"
                                          Foreground="Gray"/>
                                <StackPanel Grid.Column="1" 
                                           Orientation="Horizontal"
                                           HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding CurrentMolecule.MolarMass, StringFormat={}{0:F2}}" 
                                              FontSize="16"
                                              FontWeight="Bold"/>
                                    <TextBlock Text=" g/mol" 
                                              FontSize="12"
                                              VerticalAlignment="Bottom"
                                              Margin="2,0,0,1"/>
                                </StackPanel>
                            </Grid>
                        </materialDesign:Card>

                        <materialDesign:Card Padding="12" 
                                            Margin="0,4"
                                            Background="{DynamicResource MaterialDesignChipBackground}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Geometria" 
                                          FontSize="12"
                                          Foreground="Gray"/>
                                <TextBlock Grid.Column="1" 
                                          Text="{Binding CurrentMolecule.Geometry}" 
                                          FontSize="14"
                                          FontWeight="SemiBold"
                                          HorizontalAlignment="Right"/>
                            </Grid>
                        </materialDesign:Card>
                    </StackPanel>

                    <Separator Margin="16,8"/>

                    <!-- Lista de Átomos -->
                    <StackPanel Margin="16">
                        <TextBlock Text="Átomos na Molécula" 
                                  Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                  Margin="0,0,0,8"/>

                        <ListView ItemsSource="{Binding CurrentMolecule.Atoms}"
                                 SelectionMode="Single"
                                 MaxHeight="200">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource MaterialDesignChipBackground}"
                                           CornerRadius="4"
                                           Padding="8,4"
                                           Margin="2">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="{Binding Element.DisplayColor, Converter={StaticResource ColorToBrushConverter}}"
                                                       Width="24"
                                                       Height="24"
                                                       CornerRadius="12"
                                                       Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Element.Symbol}" 
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              FontWeight="Bold"
                                                              FontSize="11"/>
                                                </Border>
                                                <TextBlock Text="{Binding Element.Name}" 
                                                          VerticalAlignment="Center"
                                                          FontSize="13"/>
                                            </StackPanel>

                                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                                   Width="24"
                                                   Height="24"
                                                   HorizontalAlignment="Right"
                                                   Command="{Binding DataContext.RemoveAtomCommand, 
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="Close" 
                                                                        Width="16" 
                                                                        Height="16"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <Separator Margin="16,8"/>

                    <!-- Lista de Ligações -->
                    <StackPanel Margin="16">
                        <TextBlock Text="Ligações Químicas" 
                                  Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                  Margin="0,0,0,8"/>

                        <ListView ItemsSource="{Binding CurrentMolecule.Bonds}"
                                 SelectionMode="Single"
                                 MaxHeight="200">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource MaterialDesignChipBackground}"
                                           CornerRadius="4"
                                           Padding="8,4"
                                           Margin="2">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Atom1.Element.Symbol}" 
                                                          FontWeight="Bold"
                                                          Margin="0,0,4,0"/>
                                                <TextBlock Text="—" 
                                                          Foreground="Gray"
                                                          Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding Atom2.Element.Symbol}" 
                                                          FontWeight="Bold"
                                                          Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Type}" 
                                                          FontSize="11"
                                                          Foreground="Gray"
                                                          VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                                   Width="24"
                                                   Height="24"
                                                   HorizontalAlignment="Right"
                                                   Command="{Binding DataContext.RemoveBondCommand, 
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="Close" 
                                                                        Width="16" 
                                                                        Height="16"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </materialDesign:Card>
    </Grid>
</UserControl>