<UserControl x:Class="ChemicalSimulator.Views.ReactionSimulatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:oxy="http://oxyplot.org/wpf"
             xmlns:controls="clr-namespace:ChemicalSimulator.Controls"
             xmlns:converters="clr-namespace:ChemicalSimulator.Converters"
             Background="{DynamicResource MaterialDesign.Brush.Background}">

    <UserControl.Resources>
        <converters:BooleanToColorConverter x:Key="BoolToColorConverter"/>
        <converters:EnergyToColorConverter x:Key="EnergyToColorConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Cabeçalho -->
            <materialDesign:Card Grid.Row="0" Padding="16,12" Margin="0,0,0,16"
                                materialDesign:ElevationAssist.Elevation="Dp2">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="" FontSize="28" VerticalAlignment="Center"/>
                        <TextBlock Text="Simulador de Reações Químicas" 
                                 FontSize="22" FontWeight="SemiBold" 
                                 Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <!-- Conteúdo Principal -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="0.7*"/>
                </Grid.ColumnDefinitions>

                <!-- Coluna Esquerda -->
                <StackPanel Grid.Column="0" Margin="0,0,8,0">

                    <!-- REAGENTES -->
                    <materialDesign:Card Padding="16" Margin="0,0,0,12"
                                       materialDesign:ElevationAssist.Elevation="Dp2">
                        <StackPanel>
                            <TextBlock Text=" Reagentes" 
                                     FontSize="16" FontWeight="SemiBold" 
                                     Margin="0,0,0,12"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Reagente 1 -->
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBlock Grid.Column="0" Text="Reagente 1" 
                                                 Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                 Margin="0,0,0,4"/>
                                        
                                        <Button Grid.Column="1"
                                               Content="Construir"
                                               Style="{StaticResource MaterialDesignOutlinedButton}"
                                               Height="24" Padding="8,0"
                                               materialDesign:ButtonAssist.CornerRadius="4"
                                               Click="BuildReactant1_Click"/>
                                    </Grid>
                                    
                                    <ComboBox ItemsSource="{Binding AvailableCompounds}"
                                            SelectedItem="{Binding SelectedReactant1}"
                                            DisplayMemberPath="Name"
                                            materialDesign:HintAssist.Hint="Selecione o reagente"
                                            Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                            Margin="0,4,0,8"/>
                                    
                                    <TextBlock Text="Quantidade (g)" 
                                             Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                             Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" 
                                              Minimum="0.1" Maximum="100" 
                                              Value="{Binding Reactant1Amount}"
                                              TickFrequency="0.1"
                                              Style="{StaticResource MaterialDesign3.MaterialDesignDiscreteHorizontalSlider}"
                                              Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1" 
                                                 Text="{Binding Reactant1Amount, StringFormat={}{0:F1} g}"
                                                 FontWeight="SemiBold"
                                                 VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Símbolo + -->
                                <TextBlock Grid.Column="1" Text="+" 
                                         FontSize="24" FontWeight="Bold"
                                         Foreground="{DynamicResource PrimaryHueMidBrush}"
                                         VerticalAlignment="Center"
                                         HorizontalAlignment="Center"
                                         Margin="12,0"/>

                                <!-- Reagente 2 -->
                                <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBlock Grid.Column="0" Text="Reagente 2 (Opcional)" 
                                                 Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                 Margin="0,0,0,4"/>
                                        
                                        <Button Grid.Column="1"
                                               Content="Construir"
                                               Style="{StaticResource MaterialDesignOutlinedButton}"
                                               Height="24" Padding="8,0"
                                               materialDesign:ButtonAssist.CornerRadius="4"
                                               Click="BuildReactant2_Click"/>
                                    </Grid>
                                    
                                    <ComboBox ItemsSource="{Binding AvailableCompounds}"
                                            SelectedItem="{Binding SelectedReactant2}"
                                            DisplayMemberPath="Name"
                                            materialDesign:HintAssist.Hint="Selecione o reagente"
                                            Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                            Margin="0,4,0,8"/>
                                    
                                    <TextBlock Text="Quantidade (g)" 
                                             Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                             Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" 
                                              Minimum="0.1" Maximum="100" 
                                              Value="{Binding Reactant2Amount}"
                                              TickFrequency="0.1"
                                              Style="{StaticResource MaterialDesign3.MaterialDesignDiscreteHorizontalSlider}"
                                              Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1" 
                                                 Text="{Binding Reactant2Amount, StringFormat={}{0:F1} g}"
                                                 FontWeight="SemiBold"
                                                 VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- Botão Prever -->
                            <Button Content="PREVER PRODUTOS"
                                  Style="{StaticResource MaterialDesignRaisedButton}"
                                  Command="{Binding PredictProductsCommand}"
                                  Margin="0,16,0,0"
                                  HorizontalAlignment="Center"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- EQUAÇÃO QUÍMICA -->
                    <materialDesign:Card Padding="16" Margin="0,0,0,12"
                                       materialDesign:ElevationAssist.Elevation="Dp2">
                        <StackPanel>
                            <TextBlock Text=" Equação Química" 
                                     FontSize="16" FontWeight="SemiBold" 
                                     Margin="0,0,0,12"/>

                            <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                                  BorderBrush="{Binding IsBalanced, Converter={StaticResource BoolToColorConverter}}"
                                  BorderThickness="2"
                                  CornerRadius="8" 
                                  Padding="16"
                                  Margin="0,0,0,12">
                                <TextBlock Text="{Binding BalancedEquation, FallbackValue='Selecione reagentes...'}"
                                         FontSize="16"
                                         FontFamily="Consolas"
                                         FontWeight="SemiBold"
                                         TextWrapping="Wrap"
                                         HorizontalAlignment="Center"/>
                            </Border>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" 
                                           Fill="{Binding IsBalanced, Converter={StaticResource BoolToColorConverter}}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0"/>
                                    <TextBlock Text="Balanceada" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Grid.Column="1" 
                                         Text="{Binding ReactionTypeText, FallbackValue='Tipo: N/A'}"
                                         Foreground="{DynamicResource PrimaryHueMidBrush}"
                                         HorizontalAlignment="Right"
                                         FontWeight="SemiBold"/>
                            </Grid>

                            <Button Content="AUTO-BALANCEAR"
                                  Style="{StaticResource MaterialDesignOutlinedButton}"
                                  Command="{Binding AutoBalanceCommand}"
                                  HorizontalAlignment="Center"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- CONDIÇÕES -->
                    <materialDesign:Card Padding="16" Margin="0,0,0,12"
                                       materialDesign:ElevationAssist.Elevation="Dp2">
                        <StackPanel>
                            <TextBlock Text=" Condições da Reação" 
                                     FontSize="16" FontWeight="SemiBold" 
                                     Margin="0,0,0,12"/>

                            <!-- Temperatura -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text=" Temperatura" 
                                         Style="{StaticResource MaterialDesignBody2TextBlock}"
                                         Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <Slider Grid.Column="0"
                                          Style="{StaticResource MaterialDesign3.MaterialDesignDiscreteHorizontalSlider}"
                                          Minimum="0" Maximum="500"
                                          Value="{Binding TemperatureCelsius}"
                                          TickFrequency="1"
                                          Margin="0,0,12,0"/>
                                    
                                    <materialDesign:Chip Grid.Column="1"
                                                        Content="{Binding TemperatureDisplay}"/>
                                </Grid>
                            </StackPanel>

                            <!-- Pressão -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text=" Pressão" 
                                         Style="{StaticResource MaterialDesignBody2TextBlock}"
                                         Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <Slider Grid.Column="0"
                                          Style="{StaticResource MaterialDesign3.MaterialDesignDiscreteHorizontalSlider}"
                                          Minimum="10" Maximum="1000"
                                          Value="{Binding Pressure}"
                                          TickFrequency="1"
                                          Margin="0,0,12,0"/>
                                    
                                    <materialDesign:Chip Grid.Column="1"
                                                        Content="{Binding PressureDisplay}"
                                                        />
                                </Grid>
                            </StackPanel>

                            <!-- Catalisador -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" 
                                        Content="Usar Catalisador"
                                        IsChecked="{Binding UsesCatalyst}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,12,0"/>

                                <TextBox Grid.Column="1"
                                       Text="{Binding Catalyst, UpdateSourceTrigger=PropertyChanged}"
                                       IsEnabled="{Binding UsesCatalyst}"
                                       materialDesign:HintAssist.Hint="Nome do catalisador"
                                       Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                            </Grid>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- ANIMAÇÃO 3D -->
                    <materialDesign:Card Padding="16" Margin="0,0,0,12"
                                       materialDesign:ElevationAssist.Elevation="Dp2">
                        <StackPanel>
                            <TextBlock Text=" Animação Molecular 3D" 
                                     FontSize="16" FontWeight="SemiBold" 
                                     Margin="0,0,0,12"/>

                            <controls:MolecularAnimation3DControl x:Name="MolecularAnimation3D"
                                                                 Height="350"
                                                                 Margin="0,0,0,12"/>

                            <!-- Progresso -->
                            <ProgressBar Value="{Binding AnimationProgress}"
                                       Maximum="100"
                                       Height="6"
                                       Margin="0,0,0,8"/>

                            <TextBlock Text="{Binding AnimationStepDescription, FallbackValue='Clique em Iniciar'}"
                                     Foreground="{DynamicResource SecondaryHueMidBrush}"
                                     FontWeight="SemiBold"
                                     TextAlignment="Center"
                                     Margin="0,0,0,12"/>

                            <!-- Controles -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" 
                                      Content=" Iniciar"
                                      Style="{StaticResource MaterialDesignRaisedButton}"
                                      Command="{Binding StartAnimationCommand}"
                                      Margin="0,0,4,0"/>

                                <Button Grid.Column="1" 
                                      Content=" Pausar"
                                      Style="{StaticResource MaterialDesignOutlinedButton}"
                                      Command="{Binding PauseAnimationCommand}"
                                      Margin="4,0"/>

                                <Button Grid.Column="2" 
                                      Content=" Resetar"
                                      Style="{StaticResource MaterialDesignOutlinedButton}"
                                      Command="{Binding ResetAnimationCommand}"
                                      Margin="4,0,12,0"/>

                                <ComboBox Grid.Column="3"
                                        SelectedValue="{Binding AnimationSpeed}"
                                        Width="110"
                                        Style="{StaticResource MaterialDesignOutlinedComboBox}">
                                    <ComboBoxItem Content="Lenta"/>
                                    <ComboBoxItem Content="Normal" IsSelected="True"/>
                                    <ComboBoxItem Content="Rápida"/>
                                    <ComboBoxItem Content="Instantânea"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </materialDesign:Card>

                </StackPanel>

                <!-- Coluna Direita -->
                <StackPanel Grid.Column="1" Margin="8,0,0,0">

                    <!-- TERMODINÂMICA -->
                    <materialDesign:Card Padding="16" Margin="0,0,0,12"
                                       materialDesign:ElevationAssist.Elevation="Dp2">
                        <StackPanel>
                            <TextBlock Text=" Termodinâmica" 
                                     FontSize="16" FontWeight="SemiBold" 
                                     Margin="0,0,0,12"/>

                            <Border Background="{Binding IsExothermic, Converter={StaticResource EnergyToColorConverter}}"
                                  CornerRadius="8"
                                  Padding="12"
                                  Margin="0,0,0,16">
                                <TextBlock Text="{Binding EnergyTypeText}"
                                         FontSize="18"
                                         FontWeight="Bold"
                                         Foreground="White"
                                         HorizontalAlignment="Center"/>
                            </Border>

                            <!-- ΔH -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="ΔH (Entalpia):" 
                                         VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" 
                                         Text="{Binding EnthalpyChange, StringFormat={}{0:F2} kJ/mol}"
                                         Foreground="{Binding IsExothermic, Converter={StaticResource EnergyToColorConverter}}"
                                         FontWeight="Bold"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Center"/>
                            </Grid>

                            <!-- ΔG -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="ΔG (Gibbs):" 
                                         VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" 
                                         Text="{Binding GibbsFreeEnergy, StringFormat={}{0:F2} kJ/mol}"
                                         Foreground="{Binding IsSpontaneous, Converter={StaticResource BoolToColorConverter}}"
                                         FontWeight="Bold"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Ea -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Ea (Ativação):" 
                                         VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" 
                                         Text="{Binding ActivationEnergy, StringFormat={}{0:F2} kJ/mol}"
                                         Foreground="{DynamicResource SecondaryHueMidBrush}"
                                         FontWeight="Bold"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Espontaneidade -->
                            <materialDesign:Chip Content="{Binding IsSpontaneous, StringFormat='Reação {0}'}"
                                               Background="{Binding IsSpontaneous, Converter={StaticResource BoolToColorConverter}}"
                                               Foreground="White"
                                               HorizontalAlignment="Center"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- DIAGRAMA -->
                    <materialDesign:Card Padding="16" Margin="0,0,0,12"
                                       materialDesign:ElevationAssist.Elevation="Dp2">
                        <StackPanel>
                            <TextBlock Text=" Diagrama de Energia" 
                                     FontSize="16" FontWeight="SemiBold" 
                                     Margin="0,0,0,12"/>
                            
                            <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                                  BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.Border}"
                                  BorderThickness="1"
                                  CornerRadius="8"
                                  Height="280">
                                <oxy:PlotView Model="{Binding EnergyDiagram}"
                                            Background="Transparent"/>
                            </Border>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- ESTEQUIOMETRIA -->
                    <materialDesign:Card Padding="16"
                                       materialDesign:ElevationAssist.Elevation="Dp2">
                        <StackPanel>
                            <TextBlock Text=" Estequiometria" 
                                     FontSize="16" FontWeight="SemiBold" 
                                     Margin="0,0,0,12"/>

                            <!-- Reagente Limitante -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" 
                                         Text="Reagente Limitante:" 
                                         VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" 
                                         Text="{Binding LimitingReagent, FallbackValue='N/A'}"
                                         Foreground="{DynamicResource SecondaryHueMidBrush}"
                                         FontWeight="Bold"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Rendimento Teórico -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" 
                                         Text="Rendimento Teórico:" 
                                         VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" 
                                         Text="{Binding TheoreticalYield, StringFormat={}{0:F2} g}"
                                         Foreground="{DynamicResource PrimaryHueMidBrush}"
                                         FontWeight="Bold"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Rendimento % -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" 
                                         Text="Rendimento %:" 
                                         VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" 
                                         Text="{Binding PercentYield, StringFormat={}{0:F1}%}"
                                         Foreground="{DynamicResource PrimaryHueMidBrush}"
                                         FontWeight="Bold"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </materialDesign:Card>

                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
