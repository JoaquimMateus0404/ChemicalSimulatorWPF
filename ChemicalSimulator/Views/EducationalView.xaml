<UserControl x:Class="ChemicalSimulator.Views.EducationalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource MaterialDesign.Brush.Background}">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Lista de Tópicos -->
        <materialDesign:Card Grid.Column="0" Margin="0,0,8,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource MaterialDesign.Brush.Primary}" Padding="16">
                    <TextBlock Text="📚 Tópicos de Aprendizado" FontSize="18" FontWeight="Bold" Foreground="White"/>
                </Border>

                <ListBox Grid.Row="1" ItemsSource="{Binding AvailableTopics}"
                        Margin="8">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12" Margin="4" CornerRadius="4"
                                   Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Medium"/>
                                    <TextBlock Text="{Binding Description}" FontSize="11" 
                                             Opacity="0.7" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <Border Background="#2196F3" CornerRadius="8" Padding="6,2" 
                                           HorizontalAlignment="Left" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding Difficulty}" FontSize="10" 
                                                 Foreground="White" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                            <EventSetter Event="MouseDoubleClick" 
                                        Handler="TopicItem_MouseDoubleClick"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <Border Grid.Row="2" Background="#FFC107" Padding="16">
                    <StackPanel>
                        <TextBlock Text="🏆 Sua Pontuação" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="{Binding UserScore}" FontSize="32" FontWeight="Bold" 
                                 Foreground="White" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </materialDesign:Card>

        <!-- Conteúdo da Lição -->
        <materialDesign:Card Grid.Column="1" Margin="4,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource MaterialDesign.Brush.Primary}">
                    <StackPanel Margin="16">
                        <TextBlock Text="{Binding CurrentTopic}" FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <ProgressBar Value="{Binding ProgressPercentage, Mode=OneWay}" Margin="0,8,0,0" Height="8"/>
                        <TextBlock FontSize="12" Foreground="White" Margin="0,4,0,0">
                            <Run Text="Passo"/>
                            <Run Text="{Binding CurrentStep, Mode=OneWay}"/>
                            <Run Text="de"/>
                            <Run Text="{Binding TotalSteps, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="32">
                    <TextBlock Text="{Binding CurrentContent}" 
                             FontSize="16" LineHeight="28" 
                             TextWrapping="Wrap" FontFamily="Segoe UI"/>
                </ScrollViewer>

                <Border Grid.Row="2" Background="{DynamicResource MaterialDesign.Brush.Card.Background}" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="⬅️ Anterior" 
                               Command="{Binding PreviousStepCommand}"
                               Style="{StaticResource MaterialDesignOutlinedButton}"/>

                        <TextBlock Grid.Column="1" 
                                 Text="Use as setas para navegar entre os passos" 
                                 VerticalAlignment="Center" HorizontalAlignment="Center"
                                 FontSize="12" Opacity="0.7"/>

                        <Button Grid.Column="2" Content="Próximo ➡️" 
                               Command="{Binding NextStepCommand}"
                               Style="{StaticResource MaterialDesignRaisedButton}"/>
                    </Grid>
                </Border>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
