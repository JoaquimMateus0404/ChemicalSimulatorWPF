<Window x:Class="ChemicalSimulator.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:viewmodels="clr-namespace:ChemicalSimulator.ViewModels"
        xmlns:views="clr-namespace:ChemicalSimulator.Views"
        Title="Chemical Simulator - Simulador de Química Interativo" 
        Height="720" Width="1280"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Window.DataContext>
        <viewmodels:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- DataTemplates para Views -->
        <DataTemplate DataType="{x:Type viewmodels:MoleculeBuilderViewModel}">
            <views:MoleculeBuilderView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ReactionSimulatorViewModel}">
            <views:ReactionSimulatorView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:EducationalViewModel}">
            <views:EducationalView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:PeriodicTableViewModel}">
            <views:PeriodicTableView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:CompoundLibraryViewModel}">
            <views:CompoundLibraryView/>
        </DataTemplate>
    </Window.Resources>

    <materialDesign:DialogHost>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header com Título e Navegação -->
            <materialDesign:ColorZone Grid.Row="0" Mode="PrimaryMid" Padding="16,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo e Título -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Flask" Width="40" Height="40" 
                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="CHEMICAL SIMULATOR" FontSize="24" FontWeight="Bold"/>
                            <TextBlock Text="Simulador de Química Interativo" FontSize="12" Opacity="0.8"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Navegação Principal -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" 
                              HorizontalAlignment="Center" VerticalAlignment="Center">
                        
                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                               Command="{Binding NavigateToMoleculeBuilderCommand}"
                               Margin="8,0" Padding="16,8" Height="60" MinWidth="120"
                               Background="{DynamicResource MaterialDesign.Brush.Primary}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <materialDesign:PackIcon Grid.Row="0" Kind="Molecule" Width="28" Height="28" 
                                                        HorizontalAlignment="Center" Foreground="White"/>
                                <TextBlock Grid.Row="1" Text="Construtor" FontSize="12" 
                                         HorizontalAlignment="Center" Foreground="White" Margin="0,4,0,0"/>
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                               Command="{Binding NavigateToReactionSimulatorCommand}"
                               Margin="8,0" Padding="16,8" Height="60" MinWidth="120"
                               Background="#FF6F00">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <materialDesign:PackIcon Grid.Row="0" Kind="Flask" Width="28" Height="28" 
                                                        HorizontalAlignment="Center" Foreground="White"/>
                                <TextBlock Grid.Row="1" Text="Reações" FontSize="12" 
                                         HorizontalAlignment="Center" Foreground="White" Margin="0,4,0,0"/>
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                               Command="{Binding NavigateToPeriodicTableCommand}"
                               Margin="8,0" Padding="16,8" Height="60" MinWidth="120"
                               Background="#7B1FA2">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <materialDesign:PackIcon Grid.Row="0" Kind="TableLarge" Width="28" Height="28" 
                                                        HorizontalAlignment="Center" Foreground="White"/>
                                <TextBlock Grid.Row="1" Text="Tabela" FontSize="12" 
                                         HorizontalAlignment="Center" Foreground="White" Margin="0,4,0,0"/>
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                               Command="{Binding NavigateToCompoundLibraryCommand}"
                               Margin="8,0" Padding="16,8" Height="60" MinWidth="120"
                               Background="#D32F2F">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <materialDesign:PackIcon Grid.Row="0" Kind="BookOpenVariant" Width="28" Height="28" 
                                                        HorizontalAlignment="Center" Foreground="White"/>
                                <TextBlock Grid.Row="1" Text="Biblioteca" FontSize="12" 
                                         HorizontalAlignment="Center" Foreground="White" Margin="0,4,0,0"/>
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                               Command="{Binding NavigateToEducationalModeCommand}"
                               Margin="8,0" Padding="16,8" Height="60" MinWidth="120"
                               Background="#388E3C">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <materialDesign:PackIcon Grid.Row="0" Kind="School" Width="28" Height="28" 
                                                        HorizontalAlignment="Center" Foreground="White"/>
                                <TextBlock Grid.Row="1" Text="Aprender" FontSize="12" 
                                         HorizontalAlignment="Center" Foreground="White" Margin="0,4,0,0"/>
                            </Grid>
                        </Button>
                        
                    </StackPanel>

                    <!-- Informações Adicionais -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Information" Width="20" Height="20" 
                                               Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding CurrentViewName}" FontSize="14" FontWeight="Medium"/>
                    </StackPanel>
                </Grid>
            </materialDesign:ColorZone>

            <!-- Conteúdo Principal -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}" Margin="0"/>

            <!-- Rodapé -->
            <materialDesign:ColorZone Grid.Row="2" Mode="PrimaryLight" Padding="16,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12">
                        <Run Text="Chemical Simulator"/>
                        <Run Text=" | " Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                        <Run Text="Desenvolvido com WPF, MaterialDesign e HelixToolkit"/>
                    </TextBlock>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Github" Width="20" Height="20" 
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="v1.0.0" VerticalAlignment="Center" FontSize="12"/>
                    </StackPanel>
                </Grid>
            </materialDesign:ColorZone>
        </Grid>
    </materialDesign:DialogHost>
</Window>
