<Window x:Class="ChemicalSimulator.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:ChemicalSimulator.Models"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        Title="Chemical Simulator" 
        Height="900" Width="1400"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="DeepPurple" SecondaryColor="Lime" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <materialDesign:DialogHost Identifier="RootDialog">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- AppBar Superior -->
            <materialDesign:ColorZone Grid.Row="0" 
                                      Mode="PrimaryMid" 
                                      Padding="16"
                                      materialDesign:ElevationAssist.Elevation="Dp4">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <materialDesign:PackIcon Kind="Flask" 
                                                Width="32" 
                                                Height="32" 
                                                VerticalAlignment="Center"
                                                Margin="0,0,16,0"/>
                        <TextBlock Text="Chemical Simulator" 
                                  FontSize="24" 
                                  FontWeight="Bold"
                                  VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" 
                               DockPanel.Dock="Right"
                               HorizontalAlignment="Right">
                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                ToolTip="Configurações"
                                Margin="8,0">
                            <materialDesign:PackIcon Kind="Settings"/>
                        </Button>
                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                ToolTip="Ajuda"
                                Margin="8,0">
                            <materialDesign:PackIcon Kind="HelpCircle"/>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </materialDesign:ColorZone>

            <!-- Conteúdo Principal -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="350"/>
                </Grid.ColumnDefinitions>

                <!-- Painel Esquerdo - Ferramentas -->
                <materialDesign:Card Grid.Column="0" 
                                    Margin="8"
                                    Padding="0"
                                    materialDesign:ElevationAssist.Elevation="Dp2">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Expander Header="Biblioteca de Elementos"
                                     IsExpanded="True"
                                     materialDesign:ExpanderAssist.HorizontalHeaderPadding="16,8">
                                <StackPanel Margin="16">
                                    <TextBox materialDesign:HintAssist.Hint="Buscar elemento..."
                                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                            Margin="0,0,0,16"/>

                                    <!-- Tabela Periódica Simplificada -->
                                    <ItemsControl ItemsSource="{Binding CommonElements}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Width="50" 
                                                       Height="50" 
                                                       Margin="2"
                                                       Style="{StaticResource MaterialDesignOutlinedButton}"
                                                       Command="{Binding DataContext.AddElementCommand, 
                                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                                       CommandParameter="{Binding}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Symbol}" 
                                                                  FontWeight="Bold"
                                                                  FontSize="14"/>
                                                        <TextBlock Text="{Binding AtomicNumber}" 
                                                                  FontSize="10"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>

                            <Expander Header="Moléculas Comuns"
                                     materialDesign:ExpanderAssist.HorizontalHeaderPadding="16,8">
                                <ListView ItemsSource="{Binding CommonMolecules}"
                                         SelectionMode="Single"
                                         Margin="8">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="8">
                                                <materialDesign:PackIcon Kind="Molecule" 
                                                                        VerticalAlignment="Center"
                                                                        Margin="0,0,8,0"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" 
                                                              FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Formula}" 
                                                              FontSize="11"
                                                              Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Expander>

                            <Expander Header="Ferramentas de Ligação"
                                     materialDesign:ExpanderAssist.HorizontalHeaderPadding="16,8">
                                <StackPanel Margin="16">
                                    <Button Content="Ligação Simples"
                                           Style="{StaticResource MaterialDesignOutlinedButton}"
                                           Margin="0,4"
                                           HorizontalAlignment="Stretch"
                                           Command="{Binding AddBondCommand}"
                                           CommandParameter="Single"/>
                                    <Button Content="Ligação Dupla"
                                           Style="{StaticResource MaterialDesignOutlinedButton}"
                                           Margin="0,4"
                                           HorizontalAlignment="Stretch"
                                           Command="{Binding AddBondCommand}"
                                           CommandParameter="Double"/>
                                    <Button Content="Ligação Tripla"
                                           Style="{StaticResource MaterialDesignOutlinedButton}"
                                           Margin="0,4"
                                           HorizontalAlignment="Stretch"
                                           Command="{Binding AddBondCommand}"
                                           CommandParameter="Triple"/>
                                    <Button Content="Ligação Iônica"
                                           Style="{StaticResource MaterialDesignOutlinedButton}"
                                           Margin="0,4"
                                           HorizontalAlignment="Stretch"
                                           Command="{Binding AddBondCommand}"
                                           CommandParameter="Ionic"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </materialDesign:Card>

                <!-- Área Central - Visualização 3D -->
                <Grid Grid.Column="1" Margin="8">
                    <materialDesign:Card materialDesign:ElevationAssist.Elevation="Dp4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Toolbar Superior -->
                            <StackPanel Grid.Row="0" 
                                       Orientation="Horizontal" 
                                       Margin="16,8">
                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                       ToolTip="Rotacionar">
                                    <materialDesign:PackIcon Kind="Rotate3D"/>
                                </Button>
                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                       ToolTip="Zoom In">
                                    <materialDesign:PackIcon Kind="MagnifyPlus"/>
                                </Button>
                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                       ToolTip="Zoom Out">
                                    <materialDesign:PackIcon Kind="MagnifyMinus"/>
                                </Button>
                                <Separator Style="{StaticResource MaterialDesignSeparator}"
                                          Margin="8,0"/>
                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                       ToolTip="Limpar">
                                    <materialDesign:PackIcon Kind="DeleteSweep"/>
                                </Button>
                            </StackPanel>

                            <!-- Viewport 3D -->
                            <Border Grid.Row="1" 
                                   Background="#F5F5F5"
                                   CornerRadius="4"
                                   Margin="16,0,16,16">
                                <Grid>
                                    <!-- Aqui será integrado o HelixToolkit.Wpf Viewport3D -->
                                    <TextBlock Text="Área de Visualização 3D"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              FontSize="18"
                                              Foreground="#999"/>
                                </Grid>
                            </Border>

                            <!-- Controles de Ação -->
                            <StackPanel Grid.Row="2" 
                                       Orientation="Horizontal"
                                       HorizontalAlignment="Center"
                                       Margin="16">
                                <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                       Content="SIMULAR REAÇÃO"
                                       Margin="8"
                                       Padding="24,8"
                                       Command="{Binding SimulateReactionCommand}">
                                    <Button.CommandParameter>
                                        <materialDesign:PackIcon Kind="Play" 
                                                                Margin="0,0,8,0"/>
                                    </Button.CommandParameter>
                                </Button>

                                <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                       Content="Configurar Condições"
                                       Margin="8"
                                       Padding="16,8"/>
                            </StackPanel>
                        </Grid>
                    </materialDesign:Card>
                </Grid>

                <!-- Painel Direito - Propriedades e Resultados -->
                <materialDesign:Card Grid.Column="2" 
                                    Margin="8"
                                    materialDesign:ElevationAssist.Elevation="Dp2">
                    <TabControl Style="{StaticResource MaterialDesignFilledTabControl}">
                        <TabItem Header="Propriedades">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="16">
                                    <TextBlock Text="Molécula Atual" 
                                              Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                              Margin="0,0,0,16"/>

                                    <TextBox materialDesign:HintAssist.Hint="Nome"
                                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                            Margin="0,8"
                                            Text="{Binding CurrentMolecule.Name}"/>

                                    <TextBox materialDesign:HintAssist.Hint="Fórmula"
                                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                            Margin="0,8"
                                            IsReadOnly="True"
                                            Text="{Binding CurrentMolecule.Formula}"/>

                                    <Separator Margin="0,16"/>

                                    <StackPanel Margin="0,8">
                                        <TextBlock Text="Massa Molar" 
                                                  FontSize="12"
                                                  Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                        <TextBlock FontSize="18" FontWeight="SemiBold">
                                            <Run Text="{Binding CurrentMolecule.MolarMass, StringFormat={}{0:F2}}"/>
                                            <Run Text="g/mol"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Margin="0,8">
                                        <TextBlock Text="Número de Átomos" 
                                                  FontSize="12"
                                                  Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                        <TextBlock Text="{Binding CurrentMolecule.Atoms.Count}" 
                                                  FontSize="18"
                                                  FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <StackPanel Margin="0,8">
                                        <TextBlock Text="Número de Ligações" 
                                                  FontSize="12"
                                                  Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                        <TextBlock Text="{Binding CurrentMolecule.Bonds.Count}" 
                                                  FontSize="18"
                                                  FontWeight="SemiBold"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Condições">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="16">
                                    <TextBlock Text="Condições da Reação" 
                                              Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                              Margin="0,0,0,16"/>

                                    <StackPanel Margin="0,8">
                                        <TextBlock Text="{Binding Conditions.Temperature, StringFormat='Temperatura: {0:F1} K'}"
                                                  Margin="0,0,0,8"/>
                                        <Slider Minimum="200" 
                                               Maximum="500" 
                                               Value="{Binding Conditions.Temperature}"
                                               TickFrequency="50"
                                               IsSnapToTickEnabled="True"
                                               Style="{StaticResource MaterialDesign3.MaterialDesignDiscreteSlider}"/>
                                    </StackPanel>

                                    <StackPanel Margin="0,16,0,8">
                                        <TextBlock Text="{Binding Conditions.Pressure, StringFormat='Pressão: {0:F1} kPa'}"
                                                  Margin="0,0,0,8"/>
                                        <Slider Minimum="50" 
                                               Maximum="200" 
                                               Value="{Binding Conditions.Pressure}"
                                               TickFrequency="25"
                                               IsSnapToTickEnabled="True"
                                               Style="{StaticResource MaterialDesign3.MaterialDesignDiscreteSlider}"/>
                                    </StackPanel>

                                    <StackPanel Margin="0,16,0,8">
                                        <TextBlock Text="{Binding Conditions.pH, StringFormat='pH: {0:F1}'}"
                                                  Margin="0,0,0,8"/>
                                        <Slider Minimum="0" 
                                               Maximum="14" 
                                               Value="{Binding Conditions.pH}"
                                               TickFrequency="1"
                                               IsSnapToTickEnabled="True"
                                               Style="{StaticResource MaterialDesign3.MaterialDesignDiscreteSlider}"/>
                                    </StackPanel>

                                    <ComboBox materialDesign:HintAssist.Hint="Solvente"
                                             Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                             Margin="0,16,0,8"
                                             SelectedItem="{Binding Conditions.Solvent}">
                                        <ComboBoxItem Content="Nenhum"/>
                                        <ComboBoxItem Content="Água"/>
                                        <ComboBoxItem Content="Etanol"/>
                                        <ComboBoxItem Content="Acetona"/>
                                        <ComboBoxItem Content="Hexano"/>
                                    </ComboBox>

                                    <ComboBox materialDesign:HintAssist.Hint="Catalisador"
                                             Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                             Margin="0,8"
                                             SelectedItem="{Binding Conditions.Catalyst}">
                                        <ComboBoxItem Content="Nenhum"/>
                                        <ComboBoxItem Content="Pt"/>
                                        <ComboBoxItem Content="Pd"/>
                                        <ComboBoxItem Content="H2SO4"/>
                                        <ComboBoxItem Content="Enzima"/>
                                    </ComboBox>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Resultados">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="16">
                                    <TextBlock Text="Resultados da Simulação" 
                                              Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                              Margin="0,0,0,16"/>

                                    <materialDesign:Card Padding="16" 
                                                        Margin="0,8"
                                                        Background="{DynamicResource MaterialDesignChipBackground}">
                                        <StackPanel>
                                            <TextBlock Text="ΔH (Entalpia)" 
                                                      FontSize="12"
                                                      Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                            <TextBlock FontSize="20" FontWeight="Bold">
                                                <Run Text="{Binding Reaction.EnthalpyChange, StringFormat={}{0:F2}}"/>
                                                <Run Text="kJ/mol"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </materialDesign:Card>

                                    <materialDesign:Card Padding="16" 
                                                        Margin="0,8"
                                                        Background="{DynamicResource MaterialDesignChipBackground}">
                                        <StackPanel>
                                            <TextBlock Text="ΔG (Energia Livre de Gibbs)" 
                                                      FontSize="12"
                                                      Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                            <TextBlock FontSize="20" FontWeight="Bold">
                                                <Run Text="{Binding Reaction.GibbsFreeEnergy, StringFormat={}{0:F2}}"/>
                                                <Run Text="kJ/mol"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </materialDesign:Card>

                                    <materialDesign:Card Padding="16" 
                                                        Margin="0,8"
                                                        Background="{DynamicResource MaterialDesignChipBackground}">
                                        <StackPanel>
                                            <TextBlock Text="Energia de Ativação" 
                                                      FontSize="12"
                                                      Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                            <TextBlock FontSize="20" FontWeight="Bold">
                                                <Run Text="{Binding Reaction.ActivationEnergy, StringFormat={}{0:F2}}"/>
                                                <Run Text="kJ/mol"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </materialDesign:Card>

                                    <Separator Margin="0,16"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,8">
                                        <materialDesign:PackIcon Kind="CheckCircle" 
                                                                VerticalAlignment="Center"
                                                                Margin="0,0,8,0"
                                                                Foreground="Green"
                                                                Visibility="{Binding Reaction.IsSpontaneous, 
                                                                            Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <TextBlock Text="Reação Espontânea" 
                                                  VerticalAlignment="Center"
                                                  Visibility="{Binding Reaction.IsSpontaneous, 
                                                              Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>

                                    <Button Content="EXPORTAR RESULTADOS"
                                           Style="{StaticResource MaterialDesignOutlinedButton}"
                                           Margin="0,24,0,8"
                                           HorizontalAlignment="Stretch"
                                           Command="{Binding ExportResultsCommand}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </materialDesign:Card>
            </Grid>

            <!-- Barra de Status -->
            <materialDesign:ColorZone Grid.Row="2" 
                                      Mode="PrimaryLight" 
                                      Padding="16,8"
                                      materialDesign:ElevationAssist.Elevation="Dp2">
                <Grid>
                    <TextBlock Text="{Binding StatusMessage}" 
                              VerticalAlignment="Center"/>
                    <ProgressBar IsIndeterminate="True" 
                                Height="3"
                                VerticalAlignment="Bottom"
                                Visibility="{Binding IsProcessing, 
                                            Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>
            </materialDesign:ColorZone>
        </Grid>
    </materialDesign:DialogHost>
</Window>