<Window x:Class="ChemicalSimulator.Views.MoleculeBuilderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="🧪 Construtor de Moléculas" 
        Height="600" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.Resources>
        <!-- Estilo para botões de elementos -->
        <Style x:Key="ElementButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <!-- Número Atômico -->
                                <TextBlock Grid.Row="0" 
                                          Text="{TemplateBinding Tag}"
                                          FontSize="9"
                                          Foreground="White"
                                          HorizontalAlignment="Left"
                                          Margin="4,2,0,0"/>
                                
                                <!-- Símbolo -->
                                <TextBlock Grid.Row="1" 
                                          Text="{TemplateBinding Content}"
                                          FontSize="20"
                                          FontWeight="Bold"
                                          Foreground="White"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                
                                <!-- Nome -->
                                <TextBlock Grid.Row="2" 
                                          Text="{TemplateBinding ToolTip}"
                                          FontSize="8"
                                          Foreground="White"
                                          HorizontalAlignment="Center"
                                          Margin="0,0,0,2"
                                          TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#FFD700"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para átomos selecionados -->
        <Style x:Key="SelectedAtomStyle" TargetType="Border">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="CornerRadius" Value="25"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="White"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#00D9FF" BorderThickness="2" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="80"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#2D2D30" CornerRadius="8,8,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                        <TextBlock Text="🧪" FontSize="24" Margin="0,0,10,0"/>
                        <TextBlock Text="Construtor de Moléculas" 
                                  FontSize="22" 
                                  FontWeight="Bold" 
                                  Foreground="White"
                                  VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Botão Fechar -->
                    <Button Content="✕" 
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Width="40" Height="40"
                           Margin="0,0,10,0"
                           Background="Transparent"
                           Foreground="White"
                           FontSize="20"
                           BorderThickness="0"
                           Cursor="Hand"
                           Click="CloseButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E81123"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- Conteúdo Principal -->
            <Grid Grid.Row="1" Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Painel Esquerdo: Tabela Periódica Simplificada -->
                <Border Grid.Column="0" 
                       Background="#252526" 
                       CornerRadius="8" 
                       Padding="15"
                       Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="📋 Selecione os Elementos:" 
                                  FontSize="16" 
                                  FontWeight="Bold" 
                                  Foreground="#00D9FF"
                                  Margin="0,0,0,15"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <WrapPanel x:Name="ElementsPanel" 
                                      Orientation="Horizontal"
                                      HorizontalAlignment="Left"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Painel Direito: Molécula em Construção -->
                <Border Grid.Column="1" 
                       Background="#252526" 
                       CornerRadius="8" 
                       Padding="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Título -->
                        <TextBlock Grid.Row="0"
                                  Text="🔬 Sua Molécula:" 
                                  FontSize="16" 
                                  FontWeight="Bold" 
                                  Foreground="#00D9FF"
                                  Margin="0,0,0,10"/>

                        <!-- Fórmula -->
                        <Border Grid.Row="1" 
                               Background="#1E1E1E" 
                               CornerRadius="5" 
                               Padding="10"
                               Margin="0,0,0,15">
                            <TextBlock x:Name="FormulaText"
                                      Text="Vazio"
                                      FontSize="20"
                                      FontWeight="Bold"
                                      Foreground="White"
                                      HorizontalAlignment="Center"/>
                        </Border>

                        <!-- Átomos Selecionados -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="SelectedAtomsPanel">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource SelectedAtomStyle}"
                                               Background="{Binding Color}"
                                               MouseRightButtonDown="SelectedAtom_RightClick">
                                            <Grid>
                                                <TextBlock Text="{Binding Symbol}"
                                                          FontSize="18"
                                                          FontWeight="Bold"
                                                          Foreground="White"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                                
                                                <!-- Badge de Quantidade -->
                                                <Border Background="#E81123"
                                                       CornerRadius="10"
                                                       Width="20" Height="20"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Top"
                                                       Margin="-5"
                                                       Visibility="{Binding CountVisibility}">
                                                    <TextBlock Text="{Binding Count}"
                                                              FontSize="11"
                                                              FontWeight="Bold"
                                                              Foreground="White"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Nome da Molécula -->
                        <StackPanel Grid.Row="3" Margin="0,15,0,0">
                            <TextBlock Text="Nome:" 
                                      FontSize="12" 
                                      Foreground="Gray"
                                      Margin="0,0,0,5"/>
                            <TextBox x:Name="MoleculeNameText"
                                    Text="Composto Customizado"
                                    FontSize="14"
                                    Background="#1E1E1E"
                                    Foreground="White"
                                    BorderBrush="#3F3F46"
                                    BorderThickness="1"
                                    Padding="8"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Footer: Botões de Ação -->
            <Border Grid.Row="2" Background="#2D2D30" CornerRadius="0,0,8,8">
                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Dica -->
                    <StackPanel Grid.Column="0" 
                               Orientation="Horizontal" 
                               VerticalAlignment="Center">
                        <TextBlock Text="💡" FontSize="16" Margin="0,0,5,0"/>
                        <TextBlock Text="Clique nos elementos para adicionar • Clique direito para remover" 
                                  FontSize="11" 
                                  Foreground="Gray"
                                  VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Limpar -->
                    <Button Grid.Column="1"
                           Content="🗑️ Limpar"
                           Width="100"
                           Height="40"
                           Margin="10,0"
                           Background="#3E3E42"
                           Foreground="White"
                           BorderBrush="#3F3F46"
                           BorderThickness="1"
                           FontSize="14"
                           Cursor="Hand"
                           Click="ClearButton_Click"/>

                    <!-- Cancelar -->
                    <Button Grid.Column="2"
                           Content="Cancelar"
                           Width="100"
                           Height="40"
                           Margin="10,0"
                           Background="#3E3E42"
                           Foreground="White"
                           BorderBrush="#3F3F46"
                           BorderThickness="1"
                           FontSize="14"
                           Cursor="Hand"
                           Click="CancelButton_Click"/>

                    <!-- Criar -->
                    <Button Grid.Column="3"
                           Content="✅ Criar Molécula"
                           Width="150"
                           Height="40"
                           Margin="10,0"
                           Background="#0E639C"
                           Foreground="White"
                           BorderBrush="#00D9FF"
                           BorderThickness="2"
                           FontSize="14"
                           FontWeight="Bold"
                           Cursor="Hand"
                           Click="CreateButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#0E639C"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1177BB"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
