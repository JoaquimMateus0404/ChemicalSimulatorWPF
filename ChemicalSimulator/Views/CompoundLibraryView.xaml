<UserControl x:Class="ChemicalSimulator.Views.CompoundLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:ChemicalSimulator.Views"
             xmlns:converters="clr-namespace:ChemicalSimulator.Converters"
             xmlns:viewmodels="clr-namespace:ChemicalSimulator.ViewModels"
             xmlns:models="clr-namespace:ChemicalSimulator.Models"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance Type=viewmodels:CompoundLibraryViewModel}">

    <UserControl.Resources>
        <!-- Converters gerais -->
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:KelvinToCelsiusConverter x:Key="KelvinToCelsiusConverter"/>
        
        <!-- Converter para estado físico em português -->
        <local:PhysicalStateToStringConverter x:Key="StateConverter"/>
        <local:CompoundCategoryToStringConverter x:Key="CategoryConverter"/>
        <local:PhysicalStateToColorConverter x:Key="StateColorConverter"/>
        <local:CompoundCategoryToColorConverter x:Key="CategoryColorConverter"/>
        
        <!-- Estilo para cards de compostos -->
        <Style x:Key="CompoundCardStyle" TargetType="materialDesign:Card">
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="UniformCornerRadius" Value="8"/>
            <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo para botões de filtro -->
        <Style x:Key="FilterChipStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Filtros -->
            <RowDefinition Height="*"/>    <!-- Conteúdo -->
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <materialDesign:ColorZone Grid.Row="0" Mode="PrimaryMid" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Ícone e Título -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="BookOpenVariant" 
                                           Width="32" Height="32" 
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Biblioteca de Compostos" 
                                 FontSize="20" FontWeight="Bold"/>
                        <TextBlock FontSize="11" Opacity="0.9">
                            <Run Text="{Binding FilteredCount, Mode=OneWay}"/>
                            <Run Text="de"/>
                            <Run Text="{Binding TotalCompounds, Mode=OneWay}"/>
                            <Run Text="compostos"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <!-- Busca -->
                <materialDesign:Card Grid.Column="1" 
                                   Margin="24,0"
                                   VerticalAlignment="Center"
                                   UniformCornerRadius="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <materialDesign:PackIcon Kind="Magnify" 
                                               Grid.Column="0"
                                               Margin="12,0,8,0"
                                               VerticalAlignment="Center"
                                               Opacity="0.6"/>

                        <TextBox Grid.Column="1"
                               Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                               materialDesign:HintAssist.Hint="Buscar por nome, fórmula ou uso..."
                               materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                               BorderThickness="0"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Padding="4,8"/>

                        <Button Grid.Column="2"
                              Style="{StaticResource MaterialDesignToolButton}"
                              Command="{Binding ClearSearchCommand}"
                              Visibility="{Binding SearchText, Converter={StaticResource NullToVisibilityConverter}}"
                              Width="32" Height="32"
                              Margin="4,0">
                            <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                        </Button>
                    </Grid>
                </materialDesign:Card>

                <!-- Ações -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource MaterialDesignIconButton}"
                          ToolTip="Recarregar"
                          Command="{Binding RelayCommand}"
                          Margin="4,0">
                        <materialDesign:PackIcon Kind="Refresh"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconButton}"
                          ToolTip="Estatísticas"
                          Margin="4,0">
                        <materialDesign:PackIcon Kind="ChartBar"/>
                    </Button>
                </StackPanel>
            </Grid>
        </materialDesign:ColorZone>

        <!-- FILTROS E ORDENAÇÃO -->
        <materialDesign:Card Grid.Row="1" Margin="16,12,16,8" Padding="12,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Filtros por Categoria -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="Categoria:" 
                             VerticalAlignment="Center" 
                             FontWeight="SemiBold"
                             Margin="0,0,12,0"
                             FontSize="13"/>
                    
                    <Button Content="Todos" 
                          Style="{StaticResource FilterChipStyle}"
                          Command="{Binding FilterByCategoryCommand}"
                          CommandParameter="{x:Null}"/>
                    
                    <Button Content="Ácidos" 
                          Style="{StaticResource FilterChipStyle}"
                          Command="{Binding FilterByCategoryCommand}">
                        <Button.CommandParameter>
                            <models:CompoundCategory>Acid</models:CompoundCategory>
                        </Button.CommandParameter>
                    </Button>
                    
                    <Button Content="Bases" 
                          Style="{StaticResource FilterChipStyle}"
                          Command="{Binding FilterByCategoryCommand}">
                        <Button.CommandParameter>
                            <models:CompoundCategory>Base</models:CompoundCategory>
                        </Button.CommandParameter>
                    </Button>
                    
                    <Button Content="Sais" 
                          Style="{StaticResource FilterChipStyle}"
                          Command="{Binding FilterByCategoryCommand}">
                        <Button.CommandParameter>
                            <models:CompoundCategory>Salt</models:CompoundCategory>
                        </Button.CommandParameter>
                    </Button>
                    
                    <Button Content="Óxidos" 
                          Style="{StaticResource FilterChipStyle}"
                          Command="{Binding FilterByCategoryCommand}">
                        <Button.CommandParameter>
                            <models:CompoundCategory>Oxide</models:CompoundCategory>
                        </Button.CommandParameter>
                    </Button>
                    
                    <Button Content="Orgânicos" 
                          Style="{StaticResource FilterChipStyle}"
                          Command="{Binding FilterByCategoryCommand}">
                        <Button.CommandParameter>
                            <models:CompoundCategory>Organic</models:CompoundCategory>
                        </Button.CommandParameter>
                    </Button>
                </StackPanel>

                <!-- Filtros por Estado -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="Estado:" 
                             VerticalAlignment="Center" 
                             FontWeight="SemiBold"
                             Margin="0,0,12,0"
                             FontSize="13"/>
                    
                    <Button Content="Todos" 
                          Style="{StaticResource FilterChipStyle}"
                          Command="{Binding FilterByStateCommand}"
                          CommandParameter="{x:Null}"/>
                    
                    <Button Style="{StaticResource FilterChipStyle}"
                          Command="{Binding FilterByStateCommand}">
                        <Button.CommandParameter>
                            <models:PhysicalState>Solid</models:PhysicalState>
                        </Button.CommandParameter>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" 
                                   Fill="{Binding Source={x:Static models:PhysicalState.Solid}, Converter={StaticResource StateColorConverter}}"
                                   Margin="0,0,6,0"/>
                            <TextBlock Text="Sólido"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Style="{StaticResource FilterChipStyle}"
                          Command="{Binding FilterByStateCommand}">
                        <Button.CommandParameter>
                            <models:PhysicalState>Liquid</models:PhysicalState>
                        </Button.CommandParameter>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" 
                                   Fill="{Binding Source={x:Static models:PhysicalState.Liquid}, Converter={StaticResource StateColorConverter}}"
                                   Margin="0,0,6,0"/>
                            <TextBlock Text="Líquido"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Style="{StaticResource FilterChipStyle}"
                          Command="{Binding FilterByStateCommand}">
                        <Button.CommandParameter>
                            <models:PhysicalState>Gas</models:PhysicalState>
                        </Button.CommandParameter>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" 
                                   Fill="{Binding Source={x:Static models:PhysicalState.Gas}, Converter={StaticResource StateColorConverter}}"
                                   Margin="0,0,6,0"/>
                            <TextBlock Text="Gasoso"/>
                        </StackPanel>
                    </Button>

                    <!-- Separador -->
                    <Border Width="2" Background="{DynamicResource MaterialDesignDivider}" 
                          Margin="16,4" VerticalAlignment="Stretch"/>

                    <!-- Ordenação -->
                    <TextBlock Text="Ordenar:" 
                             VerticalAlignment="Center" 
                             FontWeight="SemiBold"
                             Margin="0,0,12,0"
                             FontSize="13"/>
                    
                    <Button Content="Nome" 
                          Style="{StaticResource FilterChipStyle}"
                          Command="{Binding SortCommand}"
                          CommandParameter="Name"/>
                    
                    <Button Content="Fórmula" 
                          Style="{StaticResource FilterChipStyle}"
                          Command="{Binding SortCommand}"
                          CommandParameter="Formula"/>
                    
                    <Button Content="Massa Molar" 
                          Style="{StaticResource FilterChipStyle}"
                          Command="{Binding SortCommand}"
                          CommandParameter="MolarMass"/>
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <!-- CONTEÚDO PRINCIPAL -->
        <Grid Grid.Row="2" Margin="16,0,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="400"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="350" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- LISTA DE COMPOSTOS -->
            <materialDesign:Card Grid.Column="0" Padding="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding FilteredCompounds}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <materialDesign:Card Style="{StaticResource CompoundCardStyle}"
                                                   Width="280" Height="140"
                                                   Background="White">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Comportamento de clique -->
                                        <Grid.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" 
                                                        Command="{Binding DataContext.SelectCompoundCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                        </Grid.InputBindings>

                                        <!-- Header do Card -->
                                        <Border Grid.Row="0" 
                                              Background="{Binding Category, Converter={StaticResource CategoryColorConverter}}"
                                              Padding="8,6"
                                              CornerRadius="4,4,0,0">
                                            <Grid>
                                                <TextBlock Text="{Binding Formula}" 
                                                         FontWeight="Bold" 
                                                         FontSize="18"
                                                         Foreground="White"
                                                         HorizontalAlignment="Left"/>
                                                
                                                <Ellipse Width="12" Height="12"
                                                       HorizontalAlignment="Right"
                                                       Fill="{Binding State, Converter={StaticResource StateColorConverter}}"
                                                       ToolTip="{Binding State, Converter={StaticResource StateConverter}}"/>
                                            </Grid>
                                        </Border>

                                        <!-- Conteúdo -->
                                        <StackPanel Grid.Row="1" Margin="8" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" 
                                                     FontWeight="SemiBold"
                                                     FontSize="14"
                                                     TextWrapping="Wrap"
                                                     Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                                     Margin="0,0,0,4"/>
                                            
                                            <TextBlock FontSize="11" 
                                                     Opacity="0.7" 
                                                     TextWrapping="Wrap"
                                                     Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
                                                <Run Text="Massa Molar:"/>
                                                <Run Text="{Binding MolarMass, StringFormat={}{0:F2}}" FontWeight="SemiBold"/>
                                                <Run Text="g/mol"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Footer -->
                                        <Border Grid.Row="2" 
                                              BorderBrush="{DynamicResource MaterialDesignDivider}"
                                              BorderThickness="0,1,0,0"
                                              Padding="8,4">
                                            <TextBlock Text="{Binding Category, Converter={StaticResource CategoryConverter}}" 
                                                     FontSize="11"
                                                     Opacity="0.8"
                                                     Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                                     HorizontalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </materialDesign:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </materialDesign:Card>

            <!-- Divisor -->
            <GridSplitter Grid.Column="1" 
                        Width="4" 
                        HorizontalAlignment="Center"
                        Background="Transparent"
                        Margin="4,0"/>

            <!-- PAINEL DE DETALHES -->
            <materialDesign:Card Grid.Column="2" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding SelectedCompound}">
                        <!-- Placeholder quando nenhum composto selecionado -->
                        <StackPanel x:Name="PlaceholderPanel" 
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center"
                                  Margin="0,80,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <materialDesign:PackIcon Kind="FlaskEmptyOutline" 
                                                   Width="80" Height="80"
                                                   Opacity="0.3"
                                                   HorizontalAlignment="Center"/>
                            <TextBlock Text="Selecione um composto" 
                                     FontSize="16"
                                     Opacity="0.6"
                                     HorizontalAlignment="Center"
                                     Margin="0,16,0,0"/>
                            <TextBlock Text="para ver os detalhes" 
                                     FontSize="13"
                                     Opacity="0.5"
                                     HorizontalAlignment="Center"
                                     Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Detalhes do Composto -->
                        <StackPanel x:Name="DetailsPanel">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!-- Cabeçalho -->
                            <TextBlock Text="{Binding Name}" 
                                     FontSize="24" 
                                     FontWeight="Bold"
                                     TextWrapping="Wrap"
                                     Margin="0,0,0,8"/>

                            <Border Background="{Binding Category, Converter={StaticResource CategoryColorConverter}}"
                                  CornerRadius="20"
                                  Padding="16,12"
                                  Margin="0,0,0,16">
                                <TextBlock Text="{Binding Formula}" 
                                         FontSize="32"
                                         FontWeight="Bold"
                                         Foreground="White"
                                         HorizontalAlignment="Center"/>
                            </Border>

                            <!-- Propriedades -->
                            <StackPanel Margin="0,0,0,24">
                                <!-- Massa Molar -->
                                <Border BorderBrush="{DynamicResource MaterialDesignDivider}"
                                      BorderThickness="0,0,0,1"
                                      Padding="0,8">
                                    <Grid>
                                        <TextBlock Text="Massa Molar" Opacity="0.7"/>
                                        <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold">
                                            <Run Text="{Binding MolarMass, StringFormat={}{0:F2}}"/>
                                            <Run Text="g/mol"/>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <!-- Estado Físico -->
                                <Border BorderBrush="{DynamicResource MaterialDesignDivider}"
                                      BorderThickness="0,0,0,1"
                                      Padding="0,8">
                                    <Grid>
                                        <TextBlock Text="Estado Físico" Opacity="0.7"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Ellipse Width="10" Height="10"
                                                   Fill="{Binding State, Converter={StaticResource StateColorConverter}}"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding State, Converter={StaticResource StateConverter}}" 
                                                     FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Categoria -->
                                <Border BorderBrush="{DynamicResource MaterialDesignDivider}"
                                      BorderThickness="0,0,0,1"
                                      Padding="0,8">
                                    <Grid>
                                        <TextBlock Text="Categoria" Opacity="0.7"/>
                                        <TextBlock Text="{Binding Category, Converter={StaticResource CategoryConverter}}" 
                                                 HorizontalAlignment="Right"
                                                 FontWeight="SemiBold"/>
                                    </Grid>
                                </Border>

                                <!-- Ponto de Fusão -->
                                <Border BorderBrush="{DynamicResource MaterialDesignDivider}"
                                      BorderThickness="0,0,0,1"
                                      Padding="0,8"
                                      Visibility="{Binding MeltingPoint, Converter={StaticResource NullToVisibilityConverter}}">
                                    <Grid>
                                        <TextBlock Text="Ponto de Fusão" Opacity="0.7"/>
                                        <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold">
                                            <Run Text="{Binding MeltingPoint, Converter={StaticResource KelvinToCelsiusConverter}, StringFormat={}{0:F1}}"/>
                                            <Run Text="°C"/>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <!-- Ponto de Ebulição -->
                                <Border BorderBrush="{DynamicResource MaterialDesignDivider}"
                                      BorderThickness="0,0,0,1"
                                      Padding="0,8"
                                      Visibility="{Binding BoilingPoint, Converter={StaticResource NullToVisibilityConverter}}">
                                    <Grid>
                                        <TextBlock Text="Ponto de Ebulição" Opacity="0.7"/>
                                        <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold">
                                            <Run Text="{Binding BoilingPoint, Converter={StaticResource KelvinToCelsiusConverter}, StringFormat={}{0:F1}}"/>
                                            <Run Text="°C"/>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Uso Comum -->
                            <StackPanel Margin="0,8,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CommonUse}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CommonUse}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                
                                <TextBlock Text="Uso Comum" 
                                         FontWeight="SemiBold"
                                         FontSize="14"
                                         Margin="0,0,0,8"/>
                                <Border Background="{DynamicResource MaterialDesignChipBackground}"
                                      CornerRadius="8"
                                      Padding="12">
                                    <TextBlock Text="{Binding CommonUse, FallbackValue='Informação não disponível', TargetNullValue='Sem informação'}" 
                                             TextWrapping="Wrap"
                                             LineHeight="20"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
