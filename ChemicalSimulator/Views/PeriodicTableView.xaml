<UserControl x:Class="ChemicalSimulator.Views.PeriodicTableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:ChemicalSimulator.Converters"
             xmlns:models="clr-namespace:ChemicalSimulator.Models"
             Background="{DynamicResource MaterialDesign.Brush.Background}">

    <UserControl.Resources>
        <converters:ElementCategoryToColorConverter x:Key="CategoryToColorConverter"/>
        <converters:ElementPositionConverter x:Key="ElementPositionConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:NullableIntToStringConverter x:Key="NullableIntToStringConverter"/>
        <converters:NullableDoubleToStringConverter x:Key="NullableDoubleToStringConverter"/>
        
        <!-- Estilo para os elementos da tabela periódica -->
        <Style x:Key="ElementCardStyle" TargetType="Border">
            <Setter Property="Width" Value="70"/>
            <Setter Property="Height" Value="80"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="#40000000"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" Opacity="0.2" BlurRadius="8" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#2196F3" Opacity="0.6" BlurRadius="15" ShadowDepth="3"/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="BorderBrush" Value="#2196F3"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho Compacto e Profissional -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Barra de Título e Busca -->
            <materialDesign:Card Grid.Row="0" Padding="12,8" 
                                materialDesign:ElevationAssist.Elevation="Dp2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Título -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚛️" FontSize="24" VerticalAlignment="Center"/>
                        <TextBlock Text="Tabela Periódica" FontSize="18" FontWeight="SemiBold" 
                                 Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <!-- Campo de Busca -->
                    <TextBox Grid.Column="1"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            materialDesign:HintAssist.Hint="🔍 Buscar elemento..."
                            materialDesign:TextFieldAssist.HasClearButton="True"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Margin="16,0"
                            VerticalAlignment="Center"
                            MinWidth="200"
                            MaxWidth="300"
                            Height="36"
                            FontSize="13"/>
                    
                    <!-- Contador de Elementos -->
                    <Border Grid.Column="2" 
                           Background="{DynamicResource MaterialDesign.Brush.Primary}"
                           CornerRadius="4"
                           Padding="12,4"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="118" FontSize="20" FontWeight="Bold" 
                                     Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="elementos" FontSize="11" 
                                     Foreground="White" Opacity="0.9"
                                     Margin="4,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Botão Toggle Legenda -->
                    <ToggleButton Grid.Column="3"
                                 x:Name="LegendToggle"
                                 Style="{StaticResource MaterialDesignActionToggleButton}"
                                 ToolTip="Mostrar/Ocultar Legenda"
                                 IsChecked="False"
                                 VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Palette" Width="20" Height="20"/>
                    </ToggleButton>
                </Grid>
            </materialDesign:Card>
            
            <!-- Legenda Colapsável -->
            <materialDesign:Card Grid.Row="1" 
                                Padding="12"
                                Margin="0,4,0,0"
                                materialDesign:ElevationAssist.Elevation="Dp1"
                                Visibility="{Binding IsChecked, ElementName=LegendToggle, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Categorias:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" Opacity="0.7"/>
                    <WrapPanel>
                        <Border Background="#90EE90" Width="14" Height="14" Margin="0,0,4,0" CornerRadius="2"/>
                        <TextBlock Text="Não-metais" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="11"/>
                        
                        <Border Background="#87CEFA" Width="14" Height="14" Margin="0,0,4,0" CornerRadius="2"/>
                        <TextBlock Text="Gases Nobres" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="11"/>
                        
                        <Border Background="#FF8C8C" Width="14" Height="14" Margin="0,0,4,0" CornerRadius="2"/>
                        <TextBlock Text="Alcalinos" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="11"/>
                        
                        <Border Background="#FFDA65" Width="14" Height="14" Margin="0,0,4,0" CornerRadius="2"/>
                        <TextBlock Text="Alcalino-terrosos" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="11"/>
                        
                        <Border Background="#FFB6C1" Width="14" Height="14" Margin="0,0,4,0" CornerRadius="2"/>
                        <TextBlock Text="Transição" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="11"/>
                        
                        <Border Background="#B0C4DE" Width="14" Height="14" Margin="0,0,4,0" CornerRadius="2"/>
                        <TextBlock Text="Pós-transição" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="11"/>
                        
                        <Border Background="#EEE8AA" Width="14" Height="14" Margin="0,0,4,0" CornerRadius="2"/>
                        <TextBlock Text="Metaloides" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="11"/>
                        
                        <Border Background="#DDA0DD" Width="14" Height="14" Margin="0,0,4,0" CornerRadius="2"/>
                        <TextBlock Text="Halogênios" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="11"/>
                        
                        <Border Background="#FFC0CB" Width="14" Height="14" Margin="0,0,4,0" CornerRadius="2"/>
                        <TextBlock Text="Lantanídeos" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="11"/>
                        
                        <Border Background="#E9967A" Width="14" Height="14" Margin="0,0,4,0" CornerRadius="2"/>
                        <TextBlock Text="Actinídeos" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="11"/>
                    </WrapPanel>
                </StackPanel>
            </materialDesign:Card>
        </Grid>

        <!-- Tabela Periódica com layout em Grid -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                     PanningMode="Both">
            <Grid x:Name="PeriodicTableGrid" Margin="0,0,0,16">
                <ItemsControl ItemsSource="{Binding Elements}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- Canvas para posicionamento absoluto -->
                            <!-- 18 grupos × 74px + margem = ~1400px largura -->
                            <!-- 10 períodos × 84px + espaço extra = ~950px altura -->
                            <Canvas Width="1400" Height="1000"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style>
                            <Setter Property="Canvas.Left">
                                <Setter.Value>
                                    <MultiBinding Converter="{StaticResource ElementPositionConverter}" ConverterParameter="Left">
                                        <Binding Path="Group"/>
                                        <Binding Path="Period"/>
                                        <Binding Path="Category"/>
                                        <Binding Path="AtomicNumber"/>
                                    </MultiBinding>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Canvas.Top">
                                <Setter.Value>
                                    <MultiBinding Converter="{StaticResource ElementPositionConverter}" ConverterParameter="Top">
                                        <Binding Path="Group"/>
                                        <Binding Path="Period"/>
                                        <Binding Path="Category"/>
                                        <Binding Path="AtomicNumber"/>
                                    </MultiBinding>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ElementCardStyle}"
                                   Background="{Binding Category, Converter={StaticResource CategoryToColorConverter}}"
                                   ToolTip="{Binding Name}"
                                   Tag="{Binding}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" 
                                                Command="{Binding DataContext.SelectElementCommand, 
                                                         RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                                
                                <Grid Margin="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Número Atômico -->
                                    <TextBlock Grid.Row="0" 
                                             Text="{Binding AtomicNumber}" 
                                             FontSize="10" 
                                             FontWeight="SemiBold"
                                             Opacity="0.7"
                                             HorizontalAlignment="Left"/>

                                    <!-- Símbolo do Elemento -->
                                    <TextBlock Grid.Row="1" 
                                             Text="{Binding Symbol}" 
                                             FontSize="26" 
                                             FontWeight="Bold" 
                                             HorizontalAlignment="Center" 
                                             VerticalAlignment="Center"
                                             Foreground="#212121"/>

                                    <!-- Nome do Elemento -->
                                    <TextBlock Grid.Row="2" 
                                             Text="{Binding Name}" 
                                             FontSize="9" 
                                             HorizontalAlignment="Center"
                                             TextTrimming="CharacterEllipsis"
                                             Margin="0,2,0,0"
                                             Opacity="0.8"/>

                                    <!-- Massa Atômica -->
                                    <TextBlock Grid.Row="3" 
                                             Text="{Binding AtomicMass, StringFormat='{}{0:F3}'}" 
                                             FontSize="8" 
                                             HorizontalAlignment="Center"
                                             Opacity="0.6"
                                             Margin="0,1,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>

        <!-- Painel de Detalhes do Elemento Selecionado - Compacto -->
        <materialDesign:Card Grid.Row="2" Padding="12" Margin="0,4,0,0"
                            Visibility="{Binding SelectedElement, Converter={StaticResource NullToVisibilityConverter}}"
                            materialDesign:ElevationAssist.Elevation="Dp6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Elemento Grande -->
                <Border Grid.Column="0" 
                       Width="100" Height="120" 
                       Margin="0,0,16,0"
                       Background="{Binding SelectedElement.Category, Converter={StaticResource CategoryToColorConverter}}"
                       BorderBrush="#2196F3"
                       BorderThickness="2"
                       CornerRadius="8">
                    <Border.Effect>
                        <DropShadowEffect Color="#2196F3" Opacity="0.4" BlurRadius="20" ShadowDepth="0"/>
                    </Border.Effect>
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" 
                                 Text="{Binding SelectedElement.AtomicNumber}" 
                                 FontSize="14" FontWeight="Bold"
                                 HorizontalAlignment="Left"/>
                        
                        <TextBlock Grid.Row="1" 
                                 Text="{Binding SelectedElement.Symbol}" 
                                 FontSize="40" FontWeight="Bold"
                                 HorizontalAlignment="Center" 
                                 VerticalAlignment="Center"/>
                        
                        <TextBlock Grid.Row="2" 
                                 Text="{Binding SelectedElement.Name}" 
                                 FontSize="12" FontWeight="SemiBold"
                                 HorizontalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Informações Detalhadas -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontSize="16" FontWeight="Bold" Margin="0,0,0,8">
                        <Run Text="{Binding SelectedElement.Name}"/>
                        <Run Text="(" Foreground="Gray" FontSize="14"/>
                        <Run Text="{Binding SelectedElement.Symbol}" Foreground="Gray" FontSize="14"/>
                        <Run Text=")" Foreground="Gray" FontSize="14"/>
                    </TextBlock>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Massa Atômica:" FontWeight="SemiBold" Margin="0,0,8,4"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedElement.AtomicMass, StringFormat='{}{0:F3} u'}" Margin="0,0,32,4"/>
                        
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Grupo:" FontWeight="SemiBold" Margin="0,0,8,4"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding SelectedElement.Group, Converter={StaticResource NullableIntToStringConverter}}" Margin="0,0,0,4"/>
                        
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Período:" FontWeight="SemiBold" Margin="0,0,8,4"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedElement.Period}" Margin="0,0,32,4"/>
                        
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Eletronegatividade:" FontWeight="SemiBold" Margin="0,0,8,4"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding SelectedElement.Electronegativity, Converter={StaticResource NullableDoubleToStringConverter}}" Margin="0,0,0,4"/>
                        
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Config. Eletrônica:" FontWeight="SemiBold" Margin="0,0,8,4"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding SelectedElement.ElectronConfiguration}" Margin="0,0,0,4"/>
                    </Grid>
                </StackPanel>

                <!-- Botão Fechar -->
                <Button Grid.Column="2" 
                       Style="{StaticResource MaterialDesignIconButton}"
                       Command="{Binding ClearSelectionCommand}"
                       ToolTip="Fechar"
                       VerticalAlignment="Top">
                    <materialDesign:PackIcon Kind="Close" Width="24" Height="24"/>
                </Button>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
