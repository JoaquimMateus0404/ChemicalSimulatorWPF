<UserControl x:Class="ChemicalSimulator.Controls.MoleculeViewer3D"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helix="http://helix-toolkit.org/wpf"
             Background="Transparent">

    <Grid>
        <helix:HelixViewport3D x:Name="Viewport"
                               ShowCoordinateSystem="True"
                               ShowViewCube="True"
                               Background="#F5F5F5"
                               ZoomExtentsWhenLoaded="True"
                               RotateAroundMouseDownPoint="True"
                               InfiniteSpin="False"
                               CameraRotationMode="Turntable">

            <!-- Iluminação -->
            <helix:DefaultLights/>

            <!-- Luz Adicional -->
            <helix:SunLight/>

            <!-- Grid de Referência -->
            <helix:GridLinesVisual3D Width="10" 
                                     Length="10" 
                                     MinorDistance="0.5" 
                                     MajorDistance="1" 
                                     Thickness="0.01"
                                     Fill="#40000000"/>

            <!-- Container para a Molécula -->
            <ModelVisual3D x:Name="MoleculeModel"/>

        </helix:HelixViewport3D>

        <!-- Overlay de Controles -->
        <StackPanel VerticalAlignment="Top" 
                   HorizontalAlignment="Right" 
                   Margin="16"
                   Background="#80FFFFFF"
                   Opacity="0.9">
            <Button Content="🔄 Resetar Câmera" 
                   Click="ResetCamera_Click"
                   Margin="4"
                   Padding="8,4"/>
            <Button Content="🎨 Estilo Bola-Vareta" 
                   Click="BallAndStick_Click"
                   Margin="4"
                   Padding="8,4"/>
            <Button Content="🌐 Estilo Espaço-Preenchido" 
                   Click="SpaceFilling_Click"
                   Margin="4"
                   Padding="8,4"/>
            <Button Content="📸 Capturar Imagem" 
                   Click="CaptureImage_Click"
                   Margin="4"
                   Padding="8,4"/>
        </StackPanel>

        <!-- Informações da Visualização -->
        <Border VerticalAlignment="Bottom" 
               HorizontalAlignment="Left" 
               Margin="16"
               Background="#CC000000"
               CornerRadius="4"
               Padding="12,8">
            <StackPanel>
                <TextBlock Text="Controles:" 
                          Foreground="White" 
                          FontWeight="Bold"
                          FontSize="12"/>
                <TextBlock Text="• Mouse Esquerdo: Rotacionar" 
                          Foreground="White" 
                          FontSize="10"/>
                <TextBlock Text="• Mouse Direito: Pan" 
                          Foreground="White" 
                          FontSize="10"/>
                <TextBlock Text="• Scroll: Zoom" 
                          Foreground="White" 
                          FontSize="10"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>