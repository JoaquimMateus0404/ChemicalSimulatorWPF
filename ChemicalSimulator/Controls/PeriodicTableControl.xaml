<UserControl x:Class="ChemicalSimulator.Controls.PeriodicTableControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Height="600" Width="900">

    <UserControl.Resources>
        <Style x:Key="ElementButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="NonMetalStyle" TargetType="Button" BasedOn="{StaticResource ElementButtonStyle}">
            <Setter Property="Background" Value="#FFE4B5"/>
        </Style>

        <Style x:Key="NobleGasStyle" TargetType="Button" BasedOn="{StaticResource ElementButtonStyle}">
            <Setter Property="Background" Value="#C0FFFF"/>
        </Style>

        <Style x:Key="AlkaliMetalStyle" TargetType="Button" BasedOn="{StaticResource ElementButtonStyle}">
            <Setter Property="Background" Value="#FF6B6B"/>
        </Style>

        <Style x:Key="AlkalineEarthStyle" TargetType="Button" BasedOn="{StaticResource ElementButtonStyle}">
            <Setter Property="Background" Value="#FFD93D"/>
        </Style>

        <Style x:Key="TransitionMetalStyle" TargetType="Button" BasedOn="{StaticResource ElementButtonStyle}">
            <Setter Property="Background" Value="#FFC0CB"/>
        </Style>

        <Style x:Key="HalogenStyle" TargetType="Button" BasedOn="{StaticResource ElementButtonStyle}">
            <Setter Property="Background" Value="#FFFF99"/>
        </Style>

        <Style x:Key="MetalloidStyle" TargetType="Button" BasedOn="{StaticResource ElementButtonStyle}">
            <Setter Property="Background" Value="#CCCC99"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <materialDesign:Card Grid.Row="0" Margin="8" Padding="16">
            <StackPanel>
                <TextBlock Text="Tabela Periódica dos Elementos" 
                          Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                          HorizontalAlignment="Center"/>

                <!-- Legenda -->
                <WrapPanel HorizontalAlignment="Center" Margin="0,16,0,0">
                    <Border Background="#FFE4B5" Width="20" Height="20" Margin="4" CornerRadius="2"/>
                    <TextBlock Text="Não-Metal" Margin="4" VerticalAlignment="Center"/>

                    <Border Background="#FF6B6B" Width="20" Height="20" Margin="4" CornerRadius="2"/>
                    <TextBlock Text="Metal Alcalino" Margin="4" VerticalAlignment="Center"/>

                    <Border Background="#FFD93D" Width="20" Height="20" Margin="4" CornerRadius="2"/>
                    <TextBlock Text="Alcalino-Terroso" Margin="4" VerticalAlignment="Center"/>

                    <Border Background="#FFC0CB" Width="20" Height="20" Margin="4" CornerRadius="2"/>
                    <TextBlock Text="Transição" Margin="4" VerticalAlignment="Center"/>

                    <Border Background="#FFFF99" Width="20" Height="20" Margin="4" CornerRadius="2"/>
                    <TextBlock Text="Halogênio" Margin="4" VerticalAlignment="Center"/>

                    <Border Background="#C0FFFF" Width="20" Height="20" Margin="4" CornerRadius="2"/>
                    <TextBlock Text="Gás Nobre" Margin="4" VerticalAlignment="Center"/>
                </WrapPanel>
            </StackPanel>
        </materialDesign:Card>

        <!-- Tabela Periódica -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Grid Margin="16">
                <!-- Grid 18x10 para acomodar todos os elementos -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Período 1 -->
                <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource AlkaliMetalStyle}" 
                        Tag="1" Command="{Binding ElementClickCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Self}}">
                    <StackPanel>
                        <TextBlock Text="1" FontSize="8"/>
                        <TextBlock Text="H" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="1.008" FontSize="8"/>
                    </StackPanel>
                </Button>

                <Button Grid.Row="0" Grid.Column="17" Style="{StaticResource NobleGasStyle}" Tag="2">
                    <StackPanel>
                        <TextBlock Text="2" FontSize="8"/>
                        <TextBlock Text="He" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="4.003" FontSize="8"/>
                    </StackPanel>
                </Button>

                <!-- Período 2 -->
                <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource AlkaliMetalStyle}" Tag="3">
                    <StackPanel>
                        <TextBlock Text="3" FontSize="8"/>
                        <TextBlock Text="Li" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="6.941" FontSize="8"/>
                    </StackPanel>
                </Button>

                <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource AlkalineEarthStyle}" Tag="4">
                    <StackPanel>
                        <TextBlock Text="4" FontSize="8"/>
                        <TextBlock Text="Be" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="9.012" FontSize="8"/>
                    </StackPanel>
                </Button>

                <Button Grid.Row="1" Grid.Column="12" Style="{StaticResource MetalloidStyle}" Tag="5">
                    <StackPanel>
                        <TextBlock Text="5" FontSize="8"/>
                        <TextBlock Text="B" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="10.81" FontSize="8"/>
                    </StackPanel>
                </Button>

                <Button Grid.Row="1" Grid.Column="13" Style="{StaticResource NonMetalStyle}" Tag="6">
                    <StackPanel>
                        <TextBlock Text="6" FontSize="8"/>
                        <TextBlock Text="C" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="12.01" FontSize="8"/>
                    </StackPanel>
                </Button>

                <Button Grid.Row="1" Grid.Column="14" Style="{StaticResource NonMetalStyle}" Tag="7">
                    <StackPanel>
                        <TextBlock Text="7" FontSize="8"/>
                        <TextBlock Text="N" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="14.01" FontSize="8"/>
                    </StackPanel>
                </Button>

                <Button Grid.Row="1" Grid.Column="15" Style="{StaticResource NonMetalStyle}" Tag="8">
                    <StackPanel>
                        <TextBlock Text="8" FontSize="8"/>
                        <TextBlock Text="O" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="16.00" FontSize="8"/>
                    </StackPanel>
                </Button>

                <Button Grid.Row="1" Grid.Column="16" Style="{StaticResource HalogenStyle}" Tag="9">
                    <StackPanel>
                        <TextBlock Text="9" FontSize="8"/>
                        <TextBlock Text="F" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="19.00" FontSize="8"/>
                    </StackPanel>
                </Button>

                <Button Grid.Row="1" Grid.Column="17" Style="{StaticResource NobleGasStyle}" Tag="10">
                    <StackPanel>
                        <TextBlock Text="10" FontSize="8"/>
                        <TextBlock Text="Ne" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="20.18" FontSize="8"/>
                    </StackPanel>
                </Button>

                <!-- Período 3 -->
                <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource AlkaliMetalStyle}" Tag="11">
                    <StackPanel>
                        <TextBlock Text="11" FontSize="8"/>
                        <TextBlock Text="Na" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="22.99" FontSize="8"/>
                    </StackPanel>
                </Button>

                <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource AlkalineEarthStyle}" Tag="12">
                    <StackPanel>
                        <TextBlock Text="12" FontSize="8"/>
                        <TextBlock Text="Mg" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="24.31" FontSize="8"/>
                    </StackPanel>
                </Button>

                <Button Grid.Row="2" Grid.Column="12" Style="{StaticResource ElementButtonStyle}" Background="#DDDDDD" Tag="13">
                    <StackPanel>
                        <TextBlock Text="13" FontSize="8"/>
                        <TextBlock Text="Al" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="26.98" FontSize="8"/>
                    </StackPanel>
                </Button>

                <Button Grid.Row="2" Grid.Column="13" Style="{StaticResource MetalloidStyle}" Tag="14">
                    <StackPanel>
                        <TextBlock Text="14" FontSize="8"/>
                        <TextBlock Text="Si" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="28.09" FontSize="8"/>
                    </StackPanel>
                </Button>

                <Button Grid.Row="2" Grid.Column="14" Style="{StaticResource NonMetalStyle}" Tag="15">
                    <StackPanel>
                        <TextBlock Text="15" FontSize="8"/>
                        <TextBlock Text="P" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="30.97" FontSize="8"/>
                    </StackPanel>
                </Button>

                <Button Grid.Row="2" Grid.Column="15" Style="{StaticResource NonMetalStyle}" Tag="16">
                    <StackPanel>
                        <TextBlock Text="16" FontSize="8"/>
                        <TextBlock Text="S" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="32.07" FontSize="8"/>
                    </StackPanel>
                </Button>

                <Button Grid.Row="2" Grid.Column="16" Style="{StaticResource HalogenStyle}" Tag="17">
                    <StackPanel>
                        <TextBlock Text="17" FontSize="8"/>
                        <TextBlock Text="Cl" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="35.45" FontSize="8"/>
                    </StackPanel>
                </Button>

                <Button Grid.Row="2" Grid.Column="17" Style="{StaticResource NobleGasStyle}" Tag="18">
                    <StackPanel>
                        <TextBlock Text="18" FontSize="8"/>
                        <TextBlock Text="Ar" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="39.95" FontSize="8"/>
                    </StackPanel>
                </Button>

                <!-- Período 4 - Metais de Transição -->
                <Button Grid.Row="3" Grid.Column="0" Style="{StaticResource AlkaliMetalStyle}" Tag="19">
                    <StackPanel>
                        <TextBlock Text="19" FontSize="8"/>
                        <TextBlock Text="K" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="39.10" FontSize="8"/>
                    </StackPanel>
                </Button>

                <Button Grid.Row="3" Grid.Column="1" Style="{StaticResource AlkalineEarthStyle}" Tag="20">
                    <StackPanel>
                        <TextBlock Text="20" FontSize="8"/>
                        <TextBlock Text="Ca" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="40.08" FontSize="8"/>
                    </StackPanel>
                </Button>

                <!-- Metais de Transição (21-30) -->
                <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource TransitionMetalStyle}" Tag="21">
                    <StackPanel>
                        <TextBlock Text="21" FontSize="8"/>
                        <TextBlock Text="Sc" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
                <Button Grid.Row="3" Grid.Column="3" Style="{StaticResource TransitionMetalStyle}" Tag="22">
                    <StackPanel>
                        <TextBlock Text="22" FontSize="8"/>
                        <TextBlock Text="Ti" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
                <Button Grid.Row="3" Grid.Column="4" Style="{StaticResource TransitionMetalStyle}" Tag="23">
                    <StackPanel>
                        <TextBlock Text="23" FontSize="8"/>
                        <TextBlock Text="V" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
                <Button Grid.Row="3" Grid.Column="5" Style="{StaticResource TransitionMetalStyle}" Tag="24">
                    <StackPanel>
                        <TextBlock Text="24" FontSize="8"/>
                        <TextBlock Text="Cr" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
                <Button Grid.Row="3" Grid.Column="6" Style="{StaticResource TransitionMetalStyle}" Tag="25">
                    <StackPanel>
                        <TextBlock Text="25" FontSize="8"/>
                        <TextBlock Text="Mn" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
                <Button Grid.Row="3" Grid.Column="7" Style="{StaticResource TransitionMetalStyle}" Tag="26">
                    <StackPanel>
                        <TextBlock Text="26" FontSize="8"/>
                        <TextBlock Text="Fe" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
                <Button Grid.Row="3" Grid.Column="8" Style="{StaticResource TransitionMetalStyle}" Tag="27">
                    <StackPanel>
                        <TextBlock Text="27" FontSize="8"/>
                        <TextBlock Text="Co" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
                <Button Grid.Row="3" Grid.Column="9" Style="{StaticResource TransitionMetalStyle}" Tag="28">
                    <StackPanel>
                        <TextBlock Text="28" FontSize="8"/>
                        <TextBlock Text="Ni" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
                <Button Grid.Row="3" Grid.Column="10" Style="{StaticResource TransitionMetalStyle}" Tag="29">
                    <StackPanel>
                        <TextBlock Text="29" FontSize="8"/>
                        <TextBlock Text="Cu" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
                <Button Grid.Row="3" Grid.Column="11" Style="{StaticResource TransitionMetalStyle}" Tag="30">
                    <StackPanel>
                        <TextBlock Text="30" FontSize="8"/>
                        <TextBlock Text="Zn" FontWeight="Bold"/>
                    </StackPanel>
                </Button>

                <Button Grid.Row="3" Grid.Column="16" Style="{StaticResource HalogenStyle}" Tag="35">
                    <StackPanel>
                        <TextBlock Text="35" FontSize="8"/>
                        <TextBlock Text="Br" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="79.90" FontSize="8"/>
                    </StackPanel>
                </Button>

                <Button Grid.Row="3" Grid.Column="17" Style="{StaticResource NobleGasStyle}" Tag="36">
                    <StackPanel>
                        <TextBlock Text="36" FontSize="8"/>
                        <TextBlock Text="Kr" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="83.80" FontSize="8"/>
                    </StackPanel>
                </Button>

                <!-- Informação adicional -->
                <materialDesign:Card Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="18" 
                                    Margin="0,16,0,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Elemento Selecionado" 
                                  Style="{StaticResource MaterialDesignHeadline6TextBlock}"/>
                        <TextBlock Text="{Binding SelectedElement.Name}" 
                                  FontSize="20" FontWeight="Bold" Margin="0,8,0,0"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Número Atômico" FontSize="11" Foreground="Gray"/>
                                <TextBlock Text="{Binding SelectedElement.AtomicNumber}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Massa Atômica" FontSize="11" Foreground="Gray"/>
                                <TextBlock Text="{Binding SelectedElement.AtomicMass, StringFormat={}{0:F3}}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Categoria" FontSize="11" Foreground="Gray"/>
                                <TextBlock Text="{Binding SelectedElement.Category}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>