<UserControl x:Class="ChemicalSimulator.Controls.MolecularAnimation3DControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:helix="http://helix-toolkit.org/wpf"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="600">
    
    <Border Background="#1a1f3a" CornerRadius="15" BorderBrush="#2a3555" BorderThickness="2">
        <Border.Effect>
            <DropShadowEffect Color="#00d4ff" BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
        </Border.Effect>
        
        <Grid>
            <!-- Helix 3D Viewport -->
            <helix:HelixViewport3D x:Name="viewport3D" 
                                    Background="#0a0e27"
                                    ShowCoordinateSystem="False"
                                    ShowCameraInfo="False"
                                    ShowFrameRate="False"
                                    IsInertiaEnabled="True"
                                    RotateAroundMouseDownPoint="True"
                                    ZoomAroundMouseDownPoint="True">
                
                <!-- Lighting -->
                <helix:DefaultLights/>
                
                <!-- Moléculas adicionadas dinamicamente via código C# -->
                
            </helix:HelixViewport3D>
            
            <!-- Overlay com informações -->
            <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" Margin="20">
                <TextBlock Text="🔬 Visualização Molecular 3D" 
                           FontSize="16" FontWeight="Bold" 
                           Foreground="White">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#00d4ff" BlurRadius="10" ShadowDepth="0"/>
                    </TextBlock.Effect>
                </TextBlock>
                
                <TextBlock x:Name="AnimationStepText" 
                           Text="Aguardando início da animação..." 
                           FontSize="12" 
                           Foreground="#00d4ff" 
                           Margin="0,5,0,0"/>
            </StackPanel>
            
            <!-- Legenda de cores CPK (Elementos Químicos) -->
            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="20" Background="#1a1f3a" Opacity="0.9">
                <TextBlock Text="Cores CPK dos Elementos:" FontSize="11" FontWeight="Bold" Foreground="White" Margin="5,5,5,2"/>
                <StackPanel Orientation="Horizontal" Margin="5,2">
                    <Ellipse Width="12" Height="12" Fill="White" Stroke="Gray" StrokeThickness="1" Margin="0,0,5,0"/>
                    <TextBlock Text="H (Hidrogênio)" FontSize="10" Foreground="White"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="5,2">
                    <Ellipse Width="12" Height="12" Fill="#909090" Margin="0,0,5,0"/>
                    <TextBlock Text="C (Carbono)" FontSize="10" Foreground="White"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="5,2">
                    <Ellipse Width="12" Height="12" Fill="#FF0D0D" Margin="0,0,5,0"/>
                    <TextBlock Text="O (Oxigênio)" FontSize="10" Foreground="White"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="5,2">
                    <Ellipse Width="12" Height="12" Fill="#3050F8" Margin="0,0,5,0"/>
                    <TextBlock Text="N (Nitrogênio)" FontSize="10" Foreground="White"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="5,2">
                    <Ellipse Width="12" Height="12" Fill="#FFFF30" Margin="0,0,5,0"/>
                    <TextBlock Text="S (Enxofre)" FontSize="10" Foreground="White"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="5,2">
                    <Ellipse Width="12" Height="12" Fill="#1FF01F" Margin="0,0,5,0"/>
                    <TextBlock Text="Cl (Cloro)" FontSize="10" Foreground="White"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
