<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <!-- Adicione ao seu .csproj -->
  <ItemGroup>
    <!-- MaterialDesign -->
    <PackageReference Include="HelixToolkit.Wpf" Version="3.1.2" />
    <PackageReference Include="MaterialDesignThemes" Version="5.3.0" />
    <PackageReference Include="MaterialDesignColors" Version="5.3.0" />
    
    <!-- Visualização 3D -->
    
    <!-- Gráficos -->
    <PackageReference Include="OxyPlot.Wpf" Version="2.2.0" />
    
    <!-- Controles Adicionais -->
    <PackageReference Include="MahApps.Metro" Version="2.4.11" />
    
    <!-- MVVM -->
    <PackageReference Include="Prism.Wpf" Version="9.0.537" />
    
    <!-- Exportação -->
    <PackageReference Include="QuestPDF" Version="2025.12.2" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    
    <!-- Utilitários -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <!-- Copiar arquivos de dados para o diretório de saída -->
  <ItemGroup>
    <None Update="Resources\Data\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Alternativamente, incluir como recursos embarcados -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\Data\ElementsData.json" />
    <EmbeddedResource Include="Resources\Data\CommonCompoundsData.json" />
  </ItemGroup>

</Project>
